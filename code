    except (OSError, ValueError):
        return None


def fetch_codex(acct):
    auth = codex_auth(acct)
    if not auth:
        return {"error": "not logged in"}
    t = auth.get("tokens") or {}
    if not t.get("access_token"):
        return {"error": "API-key auth (no plan limits)" if auth.get("OPENAI_API_KEY") else "not logged in"}
    try:
        u = http_json("https://chatgpt.com/backend-api/wham/usage", {
            "Authorization": "Bearer " + t["access_token"],
            "ChatGPT-Account-Id": t.get("account_id", ""),
            "User-Agent": "codex-cli",
        })
    except urllib.error.HTTPError as e:
        if e.code == 401:
            return {"error": "token expired, launch once to refresh"}
        raise
    rl = u.get("rate_limit") or {}
    windows = []
    for key in ("primary_window", "secondary_window"):
        w = rl.get(key)
        if not w:
            continue
        secs = w.get("limit_window_seconds") or 0
        lbl = "5h" if secs and secs <= 6 * 3600 else ("wk" if secs >= 6 * 86400 else f"{round(secs / 3600)}h")
        windows.append({"label": lbl, "pct": float(w.get("used_percent") or 0), "reset": w.get("reset_at")})
    windows.sort(key=lambda w: {"5h": 0}.get(w["label"], 1))
    out = {"plan": u.get("plan_type"), "email": u.get("email"), "windows": windows}
    cr = u.get("credits") or {}
    if cr.get("has_credits") or cr.get("unlimited"):
        out["extra"] = True
    return out


def fetch_openrouter(acct):
    key = key_get(acct)
    if not key:
        return {"error": "no API key stored, press l to add one"}
    hdr = {"Authorization": "Bearer " + key}
    try:
        d = http_json("https://openrouter.ai/api/v1/key", hdr).get("data") or {}
    except urllib.error.HTTPError as e:
        return {"error": "API key rejected" if e.code in (401, 403) else f"HTTP {e.code}"}
    windows, plan = [], []
    if d.get("limit"):
        lim, rem = float(d["limit"]), d.get("limit_remaining")
        used = lim - float(rem) if rem is not None else float(d.get("usage") or 0)
        windows.append({"label": {"daily": "day", "weekly": "wk", "monthly": "mo"}.get(d.get("limit_reset"), "key"),
                        "pct": 100 * used / lim, "reset": None})
        plan.append(f"${lim - used:.2f} of ${lim:.0f} key limit left")
    try:
        c = http_json("https://openrouter.ai/api/v1/credits", hdr).get("data") or {}
        total, used = float(c.get("total_credits") or 0), float(c.get("total_usage") or 0)
        if total > 0:
            windows.append({"label": "bal", "pct": 100 * used / total, "reset": None})
            plan.append(f"${total - used:.2f} credits left")
    except (urllib.error.URLError, ValueError):
        pass
    if d.get("is_free_tier"):
        plan.append("free tier")
    out = {"plan": ", ".join(plan) or f"${float(d.get('usage') or 0):.2f} used", "windows": windows}
    if acct.get("model"):
        out["email"] = acct["model"]
    return out


def fetch_grok(acct):
    if not os.path.exists(os.path.join(home_of(acct), "auth.json")) and not acct.get("keyed"):
        return {"error": "not logged in"}
    return {"windows": [], "note": "Grok has no usage API; limit hits are still detected"}


def _usage_pairs(obj, path="", out=None):
    """Best-effort: find {used, limit} pairs in an unknown JSON response."""
    out = [] if out is None else out
    if isinstance(obj, dict):
        lim = next((obj[k] for k in ("limit", "hardLimit", "includedLimit") if isinstance(obj.get(k), (int, float))), None)
        used = next((obj[k] for k in ("used", "usage", "totalSpend", "includedSpend", "spend") if isinstance(obj.get(k), (int, float))), None)
        if lim and used is not None:
            out.append({"label": (path.split(".")[-1] or "plan")[:4], "pct": 100 * used / lim, "reset": None})
        for k, v in obj.items():
            _usage_pairs(v, f"{path}.{k}" if path else k, out)
    return out


def fetch_cursor(acct):
    token = key_get(acct) if acct.get("keyed") else keychain_get("cursor-access-token", "cursor-user")
    if not token:
        return {"error": "not logged in"}
    if acct.get("keyed"):
        return {"windows": [], "note": "API-key account; Cursor only reports usage for browser logins"}
    try:
        u = http_json("https://api2.cursor.sh/aiserver.v1.DashboardService/GetCurrentPeriodUsage",
                      {"Authorization": "Bearer " + token, "Content-Type": "application/json",
                       "Connect-Protocol-Version": "1"}, body={})
    except urllib.error.HTTPError as e:
        return {"windows": [], "note": f"usage unavailable (HTTP {e.code})"}
    windows = _usage_pairs(u)[:2]
    return {"windows": windows, "note": None if windows else "usage format not recognized"}


def fetch_opencode(acct):
    try:
        with open(os.path.join(home_of(acct), "opencode", "auth.json")) as f:
            providers = sorted(json.load(f))
    except (OSError, ValueError):
        return {"error": "not logged in"}
    return {"windows": [], "plan": ", ".join(providers), "note": "no usage API"}


FETCHERS = {"claude": fetch_claude, "codex": fetch_codex, "openrouter": fetch_openrouter,
            "grok": fetch_grok, "cursor": fetch_cursor, "opencode": fetch_opencode}


def fetch_usage(acct):
    try:
        info = FETCHERS[acct["provider"]](acct)
    except urllib.error.HTTPError as e:
        info = {"error": f"HTTP {e.code}"}
    except Exception as e:  # network, parse, etc.: show it rather than crash the picker
        info = {"error": type(e).__name__ + ": " + str(e)[:60]}
    info["fetched"] = time.time()
    return info


# ---------- account management ----------

def slug(s):
    return "".join(ch if ch.isalnum() or ch in "-_" else "-" for ch in s.strip().lower()).strip("-") or "account"


def link_shared(provider, home):
    p = PROVIDERS[provider]
    src_home = p["default_home"] or PROVIDERS["claude"]["default_home"]
    for name in p["shared"]:
        src = os.path.join(src_home, name)
        dst = os.path.join(home, name)
        if os.path.exists(src) and not os.path.lexists(dst):
            os.symlink(src, dst)


def ensure_installed(provider):
    if binary_for(provider):
        return True
    p = PROVIDERS[provider]
    print(f"\n{p['label']} needs `{p['bin'][0]}`, which isn't installed. Install command:\n  {p['install']}")
    if input("Run it now? [y/N] ").strip().lower() == "y":
        subprocess.run(p["install"], shell=True)
    return bool(binary_for(provider))


def ask_key(provider):
    key = getpass.getpass(f"{PROVIDERS[provider]['key']}: ").strip()
    if not key:
        print("Cancelled.")
    return key or None


def add_account(db, provider=None, name=None):
    if provider not in PROVIDERS:
        print("Add account for:  " + "   ".join(f"{i}) {PROVIDERS[p]['label']}" for i, p in enumerate(ORDER, 1)))
        choice = input("> ").strip()
        provider = ORDER[int(choice) - 1] if choice.isdigit() and 0 < int(choice) <= len(ORDER) else None
        if not provider:
            print("Cancelled.")
            return None
    p = PROVIDERS[provider]
    if not ensure_installed(provider):
        print(f"`{p['bin'][0]}` still not found; add the account after installing it.")
        return None
    if not name:
        name = input(f"Name for this {p['label']} account (e.g. work, personal): ").strip()
    if not name:
        print("Cancelled.")
        return None
    aid = f"{provider}-{slug(name)}"
    if any(a["id"] == aid for a in db["accounts"]):
        print(f"An account named '{name}' already exists for {p['label']}.")
        return None

    use_key = provider == "openrouter"
    if provider == "cursor":
        has_browser = any(a["provider"] == "cursor" and not a.get("keyed") for a in db["accounts"])
        if has_browser:
            print("Cursor keeps one browser login per machine (you already have one), so this account uses an API key.")
            use_key = True
        else:
            use_key = input("Sign in with  1) browser (one per machine)  2) API key  > ").strip() == "2"

    home = None
    if use_key or provider != "cursor":
        home = os.path.join(DATA, provider, slug(name))
        os.makedirs(home, mode=0o700, exist_ok=True)
        link_shared(provider, home)
    acct = {"id": aid, "provider": provider, "name": name, "home": home}

    if use_key:
        key = ask_key(provider)
        if not key:
            if home:
                shutil.rmtree(home, ignore_errors=True)
            return None
        key_set(acct, key)
        acct["keyed"] = True
        if provider == "openrouter":
            acct["model"] = input("Model (e.g. anthropic/claude-opus-5.5, openai/gpt-6, x-ai/grok-5; blank = Claude Code default): ").strip() or None
    else:
        print(f"\nLogging in to {p['label']} as '{name}'. Use the account you want to link.\n")
        rc = subprocess.run([binary_for(provider)] + p["login"], env=env_for(acct)).returncode
        if rc != 0:
            print(f"\nLogin exited with code {rc}. Keeping the account; retry with: code login {aid}")
    if provider == "codex":
        acct["auto_effort"] = True
    db["accounts"].append(acct)
    save_db(db)
    cache = load_cache()
    cache.pop(aid, None)
    save_cache(cache)
    info = fetch_usage(acct)
    print(f"\nAdded {aid}: " + (info.get("error") or info.get("plan") or "ok"))
    return acct


def remove_account(db, acct):
    db["accounts"] = [a for a in db["accounts"] if a["id"] != acct["id"]]
    save_db(db)
    p = prov(acct)
    if acct.get("keyed"):
        key_del(acct)
    if acct["home"] and acct["home"].startswith(DATA + os.sep):
        if p.get("logout") and binary_for(acct["provider"]):
            subprocess.run([binary_for(acct["provider"])] + p["logout"], env=env_for(acct), capture_output=True)
        shutil.rmtree(acct["home"], ignore_errors=True)


def relogin(db, acct):
    p = prov(acct)
    if acct.get("keyed") or p.get("key") and acct["provider"] == "openrouter":
        key = ask_key(acct["provider"])
        if key:
            key_set(acct, key)
            acct["keyed"] = True
    elif p.get("login") and ensure_installed(acct["provider"]):
        subprocess.run([binary_for(acct["provider"])] + p["login"], env=env_for(acct))
    acct.pop("email", None)
    save_db(db)
    cache = load_cache()
    cache.pop(acct["id"], None)
    save_cache(cache)


# ---------- dynamic reasoning effort (Codex / GPT-6) ----------
#
# Changing top-level `reasoning.effort` changes the cached prefix. GPT-6 accepts
# {"type": "configuration_update", "reasoning": {"effort": ...}} items inside `input` instead,
# which keep the prefix intact. Codex replays the full history on every request (store:false)
# without knowing about items we inject, so every earlier update is re-inserted at the same
# position each time; otherwise the prefix would change and the cache would miss.

EFFORTS = ["none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"]
LADDER = ["low", "medium", "high", "xhigh"]  # used when the model catalog does not say
TOOL_ERR = re.compile(r"Exit code: [1-9]|\"exit_code\":\s*[1-9]|Traceback \(most recent|\bFAILED\b|\bpanicked\b"
                      r"|(?i:\berror(\[E\d+\])?:)|command not found|No such file or directory")
READ_ONLY = re.compile(r"^\s*(ls|cat|head|tail|rg|grep|find|fd|sed\s+-n|wc|pwd|tree|stat|file|nl|which"
                       r"|git\s+(status|diff|log|show|branch|blame))\b")
CALL_TYPES = ("function_call", "custom_tool_call", "local_shell_call")
OUTPUT_TYPES = ("function_call_output", "custom_tool_call_output")


def digest(item):
    return hashlib.sha1(json.dumps(item, sort_keys=True).encode()).hexdigest()


def call_text(item):
    if item.get("type") == "local_shell_call":
        a = (item.get("action") or {}).get("command")
    else:
        raw = item.get("arguments") or item.get("input") or ""
        try:
            j = json.loads(raw) if isinstance(raw, str) else raw
        except ValueError:
            return str(raw)
        a = (j.get("command") or j.get("cmd")) if isinstance(j, dict) else raw
    if isinstance(a, list):
        a = a[-1] if len(a) >= 3 and os.path.basename(str(a[0])) in ("bash", "zsh", "sh") else " ".join(map(str, a))
    return str(a or "")


def decide_effort(inp, s):
    """Pick the effort for the next generation from what happened in the current turn."""
    levels, base = s["levels"], s["base"]
    bi = levels.index(base)
    cur = s["ledger"][-1][1] if s["ledger"] else base
    ci = levels.index(cur)
    users = [i for i, it in enumerate(inp) if it.get("type") == "message" and it.get("role") == "user"]
    last_user = users[-1] if users else -1
    if last_user == len(inp) - 1:
        return base, "new user message"
    turn = inp[last_user + 1:]
    calls = [it for it in turn if it.get("type") in CALL_TYPES]
    outs = {it.get("call_id"): str(it.get("output")) for it in turn if it.get("type") in OUTPUT_TYPES}
    recent = [outs.get(c.get("call_id"), "") for c in calls[-4:]]
    errors = sum(1 for o in recent if TOOL_ERR.search(o))
    last_failed = bool(recent) and bool(TOOL_ERR.search(recent[-1]))
    # a loop = the same call returning the same output again (re-running a test after a fix is not a loop)
    seen, looping = set(), False
    for c in calls[-6:]:
        sig = (c.get("name"), call_text(c), outs.get(c.get("call_id")))
        looping |= sig in seen and sig[2] is not None
        seen.add(sig)
    if (last_failed and errors >= 2) or looping:
        return levels[min(ci + 1, bi + 2, len(levels) - 1)], (
            "stuck: same call, same result" if looping else f"stuck: {errors} of last 4 tool calls failed")
    if s["since"] < 2:
        return cur, "hold"
    last3 = calls[-3:]
    if len(last3) == 3 and errors == 0 and all(READ_ONLY.match(call_text(c)) for c in last3):
        return levels[max(0, bi - 1)], "routine read-only steps"
    if ci > bi and not last_failed:
        return base, "recovered"
    if ci < bi:
        return base, "back to normal work"
    return cur, "steady"


def efforts_from_catalog(payload):
    """Map model slug -> supported efforts from Codex's /models response (shape varies by version)."""
    out = {}
    models = (payload.get("models") or payload.get("data") or []) if isinstance(payload, dict) else payload
    for m in models if isinstance(models, list) else []:
        if not isinstance(m, dict):
            continue
        slug = m.get("slug") or m.get("id")
        raw = m.get("supported_reasoning_levels") or m.get("supported_reasoning_efforts") or []
        found = {x.get("effort") if isinstance(x, dict) else x for x in raw}
        levels = [e for e in EFFORTS if e in found]
        if slug and levels:
            out[slug] = levels
    return out


def decompress(data, encoding):
    encoding = (encoding or "").lower()
    if encoding == "gzip":
        import gzip
        return gzip.decompress(data)
    if encoding == "zstd":
        from compression import zstd  # Python 3.14+
        return zstd.decompress(data)
    return data


class EffortProxy:
    UPSTREAM = "chatgpt.com"

    def __init__(self, account_id):
        self.account_id = account_id
        self.sessions, self.model_levels = {}, {}
        self.lock = threading.Lock()
        owner = self

        class Handler(http.server.BaseHTTPRequestHandler):
            protocol_version = "HTTP/1.0"  # close-delimited responses: simplest correct way to relay SSE

            def log_message(self, *a):
                pass

            def do_GET(self):
                owner.handle(self)

            do_POST = do_GET

        self.server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Handler)
        self.server.daemon_threads = True
        self.port = self.server.server_address[1]
        threading.Thread(target=self.server.serve_forever, daemon=True).start()

    def codex_args(self):
        base = f"http://127.0.0.1:{self.port}/backend-api/codex"
        return ["-c", f'model_providers.code_switcher={{name="OpenAI",base_url="{base}",wire_api="responses",'
                      f'requires_openai_auth=true,supports_websockets=false}}',
                "-c", 'model_provider="code_switcher"']

    def log(self, line):
        try:
            with open(EFFORT_LOG, "a") as f:
                f.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')} {self.account_id} {line}\n")
        except OSError:
            pass

    def rewrite(self, body):
        """Returns (body_to_send, session_key or None if untouched)."""
        try:
            req = json.loads(body)
        except ValueError:
            return body, None
        inp = req.get("input")
        effort = (req.get("reasoning") or {}).get("effort") or "medium"
        key = req.get("prompt_cache_key") or "default"
        if not str(req.get("model", "")).startswith("gpt-6") or not isinstance(inp, list):
            return body, None
        with self.lock:
            if key not in self.sessions:
                levels = self.model_levels.get(req.get("model")) or LADDER
                self.sessions[key] = {"base": effort, "levels": levels, "ledger": [], "since": 0, "head": None,
                                      "disabled": effort not in levels, "lock": threading.Lock()}
            s = self.sessions[key]
        with s["lock"]:
            if s["disabled"]:
                return body, None
            head = digest(inp[0]) if inp else None
            valid = s["head"] in (None, head) and all(
                a <= len(inp) and (a == 0 or digest(inp[a - 1]) == d) for a, _, d in s["ledger"])
            if not valid:
                self.log(f"{key[:8]} history rewritten (compaction?); starting a fresh effort ledger")
                s["ledger"], s["since"] = [], 0
            s["head"] = head
            retry = s["ledger"] and s["ledger"][-1][0] == len(inp)
            if not retry:
                s["since"] += 1
                level, why = decide_effort(inp, s)
                cur = s["ledger"][-1][1] if s["ledger"] else s["base"]
                if level != cur:
                    s["ledger"].append((len(inp), level, digest(inp[-1]) if inp else None))
                    s["since"] = 0
                self.log(f"{key[:8]} items={len(inp)} effort={level}" + (f" (was {cur})" if level != cur else "") + f" [{why}]")
            ledger = list(s["ledger"])
        if not ledger:
            return body, key
        at = {}
        for a, lvl, _ in ledger:
            at[a] = {"type": "configuration_update", "reasoning": {"effort": lvl}}
        out = []
        for i, item in enumerate(inp):
            if i in at:
                out.append(at[i])
            out.append(item)
        if len(inp) in at:
            out.append(at[len(inp)])
        req["input"] = out
        return json.dumps(req).encode(), key

    def handle(self, h):
        if h.headers.get("Transfer-Encoding", "").lower() == "chunked":
            body = b""
            while True:
                size = int(h.rfile.readline().strip() or b"0", 16)
                if not size:
                    h.rfile.readline()
                    break
                body += h.rfile.read(size)
                h.rfile.readline()
        else:
            body = h.rfile.read(int(h.headers.get("Content-Length") or 0))
        new, key, drop_encoding = body, None, False
        if h.command == "POST" and h.path.split("?")[0].endswith("/responses"):
            try:
                enc = h.headers.get("Content-Encoding")
                plain = decompress(body, enc) if enc else body
                rewritten, key = self.rewrite(plain)
                if key and rewritten is not plain:
                    new, drop_encoding = rewritten, bool(enc)  # sent uncompressed; upstream accepts plain JSON
            except ImportError:
                self.log("request is zstd-compressed and this Python has no zstd (needs 3.14+); passing through")
            except Exception as e:  # never break the session over effort tuning
                self.log(f"rewrite failed, passing through: {e!r}")
                new, key = body, None
        resp, conn = self.upstream(h, new, drop_encoding)
        if resp.status == 400 and new is not body and key:
            err = resp.read()[:300]
            conn.close()
            with self.sessions[key]["lock"]:
                self.sessions[key].update(disabled=True, ledger=[])
            self.log(f"{key[:8]} backend rejected configuration_update ({err!r}); dynamic effort off for this session")
            resp, conn = self.upstream(h, body)
            drop_encoding = False
        h.send_response(resp.status, resp.reason)
        chunked = resp.getheader("Transfer-Encoding", "").lower() == "chunked"
        for k, v in resp.getheaders():
            if k.lower() in ("transfer-encoding", "connection", "keep-alive") or (chunked and k.lower() == "content-length"):
                continue
            h.send_header(k, v)
        h.end_headers()
        keep_all = h.command == "GET" and h.path.split("?")[0].endswith("/models") and resp.status == 200
        tail, full = b"", []
        try:
            while True:
                chunk = resp.read1(65536)
                if not chunk:
                    break
                h.wfile.write(chunk)
                h.wfile.flush()
                tail = (tail + chunk)[-65536:]
                if keep_all:
                    full.append(chunk)
        except (BrokenPipeError, ConnectionResetError):
            pass
        finally:
            conn.close()
        if keep_all:
            try:
                catalog = efforts_from_catalog(json.loads(decompress(b"".join(full), resp.getheader("Content-Encoding"))))
                with self.lock:
                    self.model_levels.update(catalog)
            except Exception:
                pass
        if key:
            inp_t = re.findall(rb'"input_tokens":\s*(\d+)', tail)
            cached = re.findall(rb'"cached_tokens":\s*(\d+)', tail)
            if inp_t:
                self.log(f"{key[:8]} tokens in={int(inp_t[-1])} cached={int(cached[-1]) if cached else 0}")

    def upstream(self, h, body, drop_encoding=False):
        conn = http.client.HTTPSConnection(self.UPSTREAM, timeout=900)
        skip = {"host", "content-length", "connection", "transfer-encoding", "proxy-connection"}
        if drop_encoding:
            skip.add("content-encoding")
        headers = {k: v for k, v in h.headers.items() if k.lower() not in skip}
        headers["Host"] = self.UPSTREAM
        if body:
            headers["Content-Length"] = str(len(body))
        conn.request(h.command, h.path, body=body or None, headers=headers)
        return conn.getresponse(), conn


def auto_effort_ok(acct, args):
    if acct["provider"] != "codex" or not acct.get("auto_effort", True):
        return False
    if any("model_provider" in a for a in args):
        return False
    auth = codex_auth(acct) or {}
    return bool((auth.get("tokens") or {}).get("access_token"))


# ---------- supervised sessions + handoff ----------

CONTINUE_NATIVE = ("The previous account hit its usage limit, so this session was moved to a different account. "
                   "Continue exactly where you left off.")

CONTINUE_TRANSCRIPT = (
    "You are taking over a conversation that started in {src} and stopped because that account hit its usage limit. "
    "The full transcript is in {path} (long tool outputs are trimmed; the raw session log is {raw}). "
    "Read the transcript first, then continue exactly where it left off: briefly say where things stand, "
    "then keep going on the last unfinished request. Don't redo work that is already done; check the files on disk if unsure."
)

# flags that mean the user is already choosing/resuming a session themselves
SESSION_FLAGS = {
    "claude": {"-r", "--resume", "-c", "--continue", "--session-id", "--fork-session", "-p", "--print"},
    "grok": {"-r", "--resume", "-c", "--continue", "-s", "--session-id", "--fork-session"},
}
GROK_LIMIT = re.compile(rb"usage_limit_reached|usage_pool_exhausted")


def claude_project_dir(home, cwd):
    return os.path.join(home, "projects", re.sub(r"[^A-Za-z0-9]", "-", cwd))


def first_json(path):
    try:
        with open(path) as f:
            return json.loads(f.readline())
    except (OSError, ValueError):
        return {}


def limit_signal(engine, d):
    """Return a reason string if this transcript entry is a usage-limit error."""
    if engine == "claude":
        if d.get("isApiErrorMessage") and d.get("error") in ("rate_limit", "billing_error"):
            return d["error"]
        return None
    p = d.get("payload")
    if not isinstance(p, dict):
        return None
    for blob in (p, p.get("error")):
        if isinstance(blob, dict) and "usage_limit" in json.dumps(blob.get("codex_error_info") or ""):
            return "usage_limit_exceeded"
    return None


def confirm_exhausted(acct, reason):
    if reason in ("billing_error", "usage_limit_exceeded", "usage_limit_reached", "usage_pool_exhausted"):
        return True
    # "rate_limit" can be a transient 429; only switch if a plan window is actually full.
    info = fetch_usage(acct)
    return any(w["pct"] >= 99.5 for w in info.get("windows") or [])


class SessionWatcher:
    """Finds the transcript the child agent is writing and tails it for usage-limit errors."""

    def __init__(self, acct, cwd, start, session_id=None, resumed=False):
        self.acct, self.cwd, self.start, self.session_id = acct, cwd, start, session_id
        self.engine = prov(acct)["engine"]
        self.resumed = resumed
        self.path, self.pos = None, 0

    def _candidates(self):
        home = home_of(self.acct)
        if self.engine == "claude":
            if self.session_id:
                hits = glob.glob(os.path.join(home, "projects", "*", self.session_id + ".jsonl"))
                if hits:
                    return hits
            return glob.glob(os.path.join(claude_project_dir(home, self.cwd), "*.jsonl"))
        if self.engine == "codex":
            days = {dt.date.fromtimestamp(t) for t in (self.start - 86400, self.start, time.time())}
            files = []
            for d in days:
                files += glob.glob(os.path.join(home, "sessions", f"{d:%Y/%m/%d}", "rollout-*.jsonl"))
            return [f for f in files if (first_json(f).get("payload") or {}).get("cwd") == self.cwd]
        if self.engine == "grok" and self.session_id:
            return glob.glob(os.path.join(home, "sessions", "*", self.session_id, "updates.jsonl"))
        return []  # cursor / opencode keep sessions in SQLite; no auto-detection

    def locate(self):
        if not self.path:
            cands = []
            for f in self._candidates():
                try:
                    if os.path.getmtime(f) >= self.start - 2:
                        cands.append(f)
                except OSError:
                    pass
            if cands:
                self.path = max(cands, key=os.path.getmtime)
                if self.engine == "claude":
                    self.session_id = os.path.basename(self.path)[:-len(".jsonl")]
                if self.engine == "grok" and self.resumed:
                    self.pos = os.path.getsize(self.path)  # old entries may contain the previous limit error
        return self.path

    def poll(self):
        if not self.locate():
            return None
        try:
            with open(self.path, "rb") as f:
                f.seek(self.pos)
                data = f.read()
        except OSError:
            return None
        end = data.rfind(b"\n")
        if end < 0:
            return None
        self.pos += end + 1
        chunk = data[:end]
        if self.engine == "grok":
            m = GROK_LIMIT.search(chunk)
            return m.group().decode() if m else None
        found = None
        for line in chunk.splitlines():
            try:
                d = json.loads(line)
            except ValueError:
                continue
            if d.get("type") == "session_meta":
                self.session_id = (d.get("payload") or {}).get("id") or self.session_id
            try:
                ts = iso_ts(d.get("timestamp"))
            except (ValueError, AttributeError):
                ts = None
            if ts and ts < self.start - 5:
                continue  # history from a resumed session, not this run
            found = limit_signal(self.engine, d) or found
        return found


def reset_terminal():
    # The agent was killed mid-TUI; undo alt screen, hidden cursor, mouse/paste/keyboard modes.
    sys.stdout.write("\x1b[?1049l\x1b[?25h\x1b[?1000l\x1b[?1002l\x1b[?1003l\x1b[?1006l\x1b[?2004l\x1b[<u\x1b[>4;0m\r\n")
    sys.stdout.flush()
    subprocess.run(["stty", "sane"], stdin=sys.stdin)


def stop_child(child):
    child.terminate()
    try:
        child.wait(timeout=5)
    except subprocess.TimeoutExpired:
        child.kill()
        child.wait()
    reset_terminal()


def fresh_session_args(acct, args):
    """Pick the session id up front where the CLI allows it, so the watcher knows which log to tail."""
    engine = prov(acct)["engine"]
    if engine in SESSION_FLAGS and not any(a.split("=")[0] in SESSION_FLAGS[engine] for a in args):
        sid = str(uuid.uuid4())
        return [("--session-id" if engine == "claude" else "-s"), sid] + args, sid
    return args, None


def supervise(db, acct, args, handoff=None):
    binary = binary_for(acct["provider"])
    if not binary:
        sys.exit(f"{label(acct)} isn't installed. Install it with:\n  {prov(acct)['install']}")
    cwd = handoff["cwd"] if handoff and os.path.isdir(handoff.get("cwd") or "") else os.getcwd()
    resumed = False
    if handoff:
        args, session_id, resumed = prepare_handoff(acct, handoff)
    else:
        args, session_id = fresh_session_args(acct, args)
    proxy = None
    if auto_effort_ok(acct, args):
        proxy = EffortProxy(acct["id"])
        args = proxy.codex_args() + args
    db["last"] = acct["id"]
    save_db(db)

    start = time.time()
    watcher = SessionWatcher(acct, cwd, start, session_id, resumed)
    # The child owns the terminal; keep Ctrl+C / Ctrl+\ from killing the supervisor too.
    saved = {s: signal.signal(s, lambda *_: None) for s in (signal.SIGINT, signal.SIGQUIT)}
    hit = None
    try:
        child = subprocess.Popen([binary] + args, env=env_for(acct), cwd=cwd)
        while child.poll() is None:
            try:
                child.wait(timeout=2)
                break
            except subprocess.TimeoutExpired:
                pass
            reason = watcher.poll()
            if reason and confirm_exhausted(acct, reason):
                hit = reason
                time.sleep(3)  # let the agent's own "limit reached" message show
                stop_child(child)
                break
        if not hit:
            reason = watcher.poll()
            if reason and confirm_exhausted(acct, reason):
                hit = reason
    finally:
        for s, h in saved.items():
            signal.signal(s, h)
        if proxy:
            proxy.server.shutdown()

    session = {"provider": acct["provider"], "account": acct["id"], "home": home_of(acct), "path": watcher.path,
               "session_id": watcher.session_id, "cwd": cwd, "ended": time.time()}
    if watcher.path:
        os.makedirs(DATA, mode=0o700, exist_ok=True)
        with open(LAST_SESSION, "w") as f:
            json.dump(session, f)
    rc = child.returncode
    return (128 - rc if rc < 0 else rc), hit, session


def run_session(db, acct, args, handoff=None):
    while True:
        rc, hit, session = supervise(db, acct, args, handoff)
        if not hit:
            return rc
        nxt = pick(db, {"exclude": acct["id"],
                        "title": f"{label(acct)} '{acct['name']}' hit its usage limit. Continue this conversation on:"})
        if not nxt:
            print("Session saved. Continue it on another account later with: code handoff")
            return rc
        acct, args, handoff = nxt, [], session


def prompt_args(target, prompt):
    """Args that start `target` interactively with `prompt` as the first message; returns (args, session_id)."""
    engine = prov(target)["engine"]
    if engine == "opencode":
        return ["--prompt", prompt], None
    args, sid = fresh_session_args(target, [])
    return args + [prompt], sid


def prepare_handoff(target, h):
    """Returns (args, session_id, resumed) that start `target` with the handed-off conversation."""
    src_engine = PROVIDERS[h["provider"]]["engine"]
    dst_engine = prov(target)["engine"]
    if src_engine == dst_engine == "claude" and h.get("path") and h.get("session_id"):
        src_dir = os.path.dirname(h["path"])
        dst_dir = os.path.join(home_of(target), "projects", os.path.basename(src_dir))
        os.makedirs(dst_dir, exist_ok=True)
        if os.path.realpath(dst_dir) != os.path.realpath(src_dir):
            shutil.copy2(h["path"], dst_dir)
            side = os.path.join(src_dir, h["session_id"])  # subagent logs, saved tool outputs
            if os.path.isdir(side):
                shutil.copytree(side, os.path.join(dst_dir, h["session_id"]), dirs_exist_ok=True)
        return ["--resume", h["session_id"], CONTINUE_NATIVE], h["session_id"], True
    if src_engine == dst_engine == "grok" and h.get("path") and h.get("session_id"):
        src_dir = os.path.dirname(h["path"])  # sessions/<cwd>/<id>/
        rel = os.path.relpath(src_dir, h.get("home") or PROVIDERS[h["provider"]]["default_home"])
        dst_dir = os.path.join(home_of(target), rel)
        if os.path.realpath(dst_dir) != os.path.realpath(src_dir):
            shutil.copytree(src_dir, dst_dir, dirs_exist_ok=True)
        return ["--resume", h["session_id"]], h["session_id"], True

    src = f"{PROVIDERS[h['provider']]['label']} (account '{h['account']}')"
    path = export_transcript(h, src)
    prompt = CONTINUE_TRANSCRIPT.format(src=src, path=path, raw=h.get("path") or "unavailable")
    args, sid = prompt_args(target, prompt)
    return args, sid, False


# ---------- transcript export ----------

NOISE = ("<environment_context>", "<user_instructions>", "# AGENTS.md", "<permissions", "<INSTRUCTIONS>",
         "<command-name>", "<local-command-stdout>", "<local-command-caveat>")


def clip(s, n):
    s = s.strip()
    return s if len(s) <= n else s[:n] + f"\n… [{len(s) - n} more characters trimmed]"


def content_parts(content):
    if isinstance(content, str):
        return [("text", content)]
    out = []
    for c in content or []:
        if not isinstance(c, dict):
            continue
        t = c.get("type")
        if t in ("text", "input_text", "output_text"):
            out.append(("text", c.get("text", "")))
        elif t == "tool_use":
            out.append(("call", f"{c.get('name')} {json.dumps(c.get('input'), ensure_ascii=False)}"))
        elif t == "tool_result":
            r = c.get("content")
            if isinstance(r, list):
                r = "\n".join(x.get("text", "") for x in r if isinstance(x, dict) and x.get("type") == "text")
            out.append(("result", str(r or "")))
        elif t in ("image", "input_image"):
            out.append(("text", "[image]"))
    return out


def jsonl(path):
    for line in open(path, errors="replace"):
        try:
            yield json.loads(line)
        except ValueError:
            continue


def claude_entries(path):
    for d in jsonl(path):
        if d.get("isSidechain") or d.get("isMeta"):
            continue
        if d.get("type") == "summary":
            yield "note", "Earlier summary: " + d.get("summary", "")
        if d.get("type") not in ("user", "assistant"):
            continue
        parts = content_parts((d.get("message") or {}).get("content"))
        if d.get("isApiErrorMessage"):
            yield "note", "API error: " + " ".join(s for _, s in parts)
            continue
        for kind, s in parts:
            yield (d["type"] if kind == "text" else kind), s


def codex_entries(path):
    for d in jsonl(path):
        p = d.get("payload")
        if not isinstance(p, dict):
            continue
        if d.get("type") != "response_item":
            if limit_signal("codex", d):
                err = p.get("error") if isinstance(p.get("error"), dict) else p
                yield "note", "Usage limit: " + str(err.get("message", ""))
            continue
        pt = p.get("type")
        if pt == "message" and p.get("role") in ("user", "assistant"):
            for _, s in content_parts(p.get("content")):
                yield p["role"], s
        elif pt in ("function_call", "custom_tool_call"):
            yield "call", f"{p.get('name')} {p.get('arguments') or p.get('input') or ''}"
        elif pt in OUTPUT_TYPES:
            out = p.get("output")
            yield "result", out if isinstance(out, str) else json.dumps(out, ensure_ascii=False)
        elif pt == "local_shell_call":
            yield "call", "shell " + json.dumps(p.get("action"), ensure_ascii=False)


def grok_entries(path):
    """Grok's chat_history.jsonl holds chat-completions style messages."""
    hist = os.path.join(os.path.dirname(path), "chat_history.jsonl")
    for d in jsonl(hist if os.path.exists(hist) else path):
        m = d.get("message") if isinstance(d.get("message"), dict) else d
        role = m.get("role")
        if role in ("user", "assistant"):
            for kind, s in content_parts(m.get("content")):
                yield (role if kind == "text" else kind), s
            for tc in m.get("tool_calls") or []:
                fn = tc.get("function") or {}
                yield "call", f"{fn.get('name')} {fn.get('arguments', '')}"
        elif role == "tool":
            yield "result", " ".join(s for _, s in content_parts(m.get("content")))


ENTRIES = {"claude": claude_entries, "codex": codex_entries, "grok": grok_entries}


def export_transcript(h, src):
    os.makedirs(HANDOFFS, mode=0o700, exist_ok=True)
    out = os.path.join(HANDOFFS, f"{time.strftime('%Y%m%d-%H%M%S')}-{h['account']}.md")
    entries = []
    gen = ENTRIES.get(PROVIDERS[h["provider"]]["engine"])
    if gen and h.get("path") and os.path.exists(h["path"]):
        entries = list(gen(h["path"]))
    lines = [f"# Conversation handed off from {src}", "",
             f"- Working directory: `{h['cwd']}`", f"- Raw session log: `{h.get('path')}`", ""]
    last_role = None
    for kind, s in entries:
        if kind in ("user", "assistant"):
            s = re.sub(r"<system-reminder>.*?</system-reminder>", "", s, flags=re.S).strip()
            if not s or s.startswith(NOISE):
                continue
            if kind != last_role:
                lines += ["", f"## {kind.title()}", ""]
                last_role = kind
            lines += [s, ""]
        elif kind == "call":
            lines += ["**Tool call:**", "````", clip(s, 2000), "````", ""]
        elif kind == "result":
            lines += ["**Tool result:**", "````", clip(s, 4000), "````", ""]
        else:
            lines += [f"> {clip(s, 1000)}", ""]
    if not entries and h.get("path") and os.path.exists(h["path"]):
        with open(h["path"], errors="replace") as f:
            lines += ["The transcript format wasn't recognized, so here is the raw session log:", "", "````",
                      clip(f.read(), 200_000), "````"]
    elif not entries:
        lines.append("_(No transcript could be read; check the raw session log above.)_")
    with open(out, "w") as f:
        f.write("\n".join(lines))
    os.chmod(out, 0o600)
    return out


# ---------- picker UI ----------

def fmt_reset(ts):
    if not ts:
        return ""
    delta = ts - time.time()
    if delta <= 0:
        return "now"
    if delta < 3600:
        return f"{int(delta // 60)}m"
    if delta < 86400:
        return f"{int(delta // 3600)}h{int(delta % 3600 // 60):02d}m"
    return dt.datetime.fromtimestamp(ts).strftime("%a %-I%p").replace("AM", "am").replace("PM", "pm")


def headroom(info):
    """Lower is better; used for the 'best pick' marker."""
    if not info or info.get("error") or not info.get("windows"):
        return 1e9
    return max(w["pct"] for w in info["windows"])


def picker(stdscr, db, usage, state, handoff=None):
    curses.curs_set(0)
    curses.use_default_colors()
    for i, c in enumerate((curses.COLOR_GREEN, curses.COLOR_YELLOW, curses.COLOR_RED, curses.COLOR_CYAN,
                           curses.COLOR_MAGENTA, curses.COLOR_BLUE), 1):
        curses.init_pair(i, c, -1)
    GREEN, YELLOW, RED, CYAN, MAG, BLUE = (curses.color_pair(i) for i in range(1, 7))
    DIM, BOLD = curses.A_DIM, curses.A_BOLD
    PCOLOR = {"claude": MAG, "codex": GREEN, "openrouter": CYAN, "grok": 0, "cursor": YELLOW, "opencode": BLUE}
    stdscr.timeout(250)

    def visible():
        return [a for a in db["accounts"] if not handoff or a["id"] != handoff["exclude"]]

    accts = visible()
    ids = [a["id"] for a in accts]
    sel = ids.index(db["last"]) if db.get("last") in ids and not handoff else 0
    auto_sel = bool(handoff)  # in handoff mode, follow the best account until the user moves
    message = ""

    def color_for(p):
        return GREEN if p < 60 else YELLOW if p < 85 else RED

    while True:
        stdscr.erase()
        h, w = stdscr.getmaxyx()

        def put(y, x, text, attr=0):
            if 0 <= y < h and x < w - 1:
                try:
                    stdscr.addstr(y, x, text[: max(0, w - 1 - x)], attr)
                except curses.error:
                    pass
            return x + len(text)

        top = 2
        if handoff:
            put(0, 2, handoff["title"], BOLD | YELLOW)
            put(1, 2, "Enter continues with the full conversation · q stops here", DIM)
            top = 3
            keys = "enter continue  a add  l re-login  r refresh  q quit"
        else:
            put(0, 2, "code", BOLD | CYAN)
            put(0, 7, "pick an account to launch", DIM)
            keys = "enter launch  a add  d remove  l re-login  e auto-effort  r refresh  q quit"
        put(h - 1, 2, keys, DIM)
        if message:
            put(h - 2, 2, message, YELLOW)

        if not accts:
            put(top, 4, "No other accounts. Press 'a' to add one." if handoff else "No accounts yet. Press 'a' to add one.")
        best = min(accts, key=lambda a: headroom(usage.get(a["id"])), default=None)
        best_id = best["id"] if best and headroom(usage.get(best["id"])) < 100 else None
        if auto_sel and best_id:
            sel = [a["id"] for a in accts].index(best_id)

        name_w = max([len(a["name"]) for a in accts] + [7])
        ind = 15
        y = top
        for i, a in enumerate(accts):
            info = usage.get(a["id"])
            is_sel = i == sel
            put(y, 1, "›" if is_sel else " ", BOLD | CYAN)
            x = put(y, 3, f"{label(a):<10}", PCOLOR[a["provider"]] | BOLD)
            x = put(y, x + 1, f"{a['name']:<{name_w}}", BOLD if is_sel else 0)
            email = (info or {}).get("email") or a.get("email") or ""
            plan = (info or {}).get("plan") or ""
            x = put(y, x + 2, email, DIM)
            if plan:
                x = put(y, x + 1, f"[{plan}]", DIM)
            if a["provider"] == "codex" and a.get("auto_effort", True):
                x = put(y, x + 1, "⚡auto-effort", CYAN)
            if a["id"] == best_id and len(accts) > 1:
                put(y, x + 1, "★ most headroom", GREEN)
            y += 1
            if info is None:
                put(y, ind, "loading usage…", DIM)
            elif info.get("error"):
                put(y, ind, info["error"], RED)
            elif not info.get("windows"):
                put(y, ind, info.get("note") or "no limit data", DIM)
            else:
                x = ind
                for win in info["windows"]:
                    pct = win["pct"]
                    filled = int(round(min(pct, 100) / 10))
                    x = put(y, x, f"{win['label']:>4} ", DIM)
                    x = put(y, x, "█" * filled, color_for(pct))
                    x = put(y, x, "░" * (10 - filled), DIM)
                    x = put(y, x, f" {pct:3.0f}%", color_for(pct) | BOLD)
                    r = fmt_reset(win.get("reset"))
                    x = put(y, x, f" resets {r}" if r else "", DIM)
                    x += 3
                if info.get("extra"):
                    put(y, x, "+extra usage", CYAN)
            y += 2
        if state["loading"]:
            put(0, w - 14, "refreshing…", DIM)
        stdscr.refresh()

        k = stdscr.getch()
        if k == -1:
            continue
        message = ""
        if k in (ord("q"), 27):
            return ("quit", None)
        if k in (curses.KEY_UP, ord("k")) and accts:
            sel, auto_sel = (sel - 1) % len(accts), False
        elif k in (curses.KEY_DOWN, ord("j")) and accts:
            sel, auto_sel = (sel + 1) % len(accts), False
        elif ord("1") <= k <= ord("9") and k - ord("1") < len(accts):
            return ("launch", accts[k - ord("1")])
        elif k in (10, 13, curses.KEY_ENTER) and accts:
            return ("launch", accts[sel])
        elif k == ord("a"):
            return ("add", None)
        elif k == ord("l") and accts:
            return ("login", accts[sel])
        elif k == ord("r"):
            state["refresh"]()
        elif k == ord("e") and accts:
            a = accts[sel]
            if a["provider"] != "codex":
                message = "Auto-effort is Codex-only: other providers lose the prompt cache when effort changes."
            else:
                a["auto_effort"] = not a.get("auto_effort", True)
                save_db(db)
                message = f"Auto-effort {'on' if a['auto_effort'] else 'off'} for '{a['name']}'."
        elif k == ord("d") and accts and not handoff:
            a = accts[sel]
            if not a["home"] and not a.get("keyed"):
                message = "Default accounts are your normal logins and can't be removed here."
                continue
            put(h - 2, 2, f"Remove {label(a)} '{a['name']}' and delete its login? (y/N) ", RED | BOLD)
            stdscr.timeout(-1)
            ans = stdscr.getch()
            stdscr.timeout(250)
            if ans in (ord("y"), ord("Y")):
                remove_account(db, a)
                accts = visible()
                sel = min(sel, max(0, len(accts) - 1))
                message = f"Removed '{a['name']}'."


def pick(db, handoff=None):
    """Show the picker until an account is chosen (returned) or the user quits (None)."""
    while True:
        cache = load_cache()
        usage = {a["id"]: cache[a["id"]] for a in db["accounts"] if a["id"] in cache}
        state = {"loading": set()}
        lock = threading.Lock()

        def worker(a):
            info = fetch_usage(a)
            with lock:
                usage[a["id"]] = info
                state["loading"].discard(a["id"])
                if info.get("email") and not a.get("email") and a["provider"] != "openrouter":
                    a["email"] = info["email"]

        def refresh(force=True):
            for a in db["accounts"]:
                fresh = a["id"] in usage and time.time() - usage[a["id"]].get("fetched", 0) < CACHE_TTL
                if a["id"] in state["loading"] or (fresh and not force):
                    continue
                state["loading"].add(a["id"])
                threading.Thread(target=worker, args=(a,), daemon=True).start()

        state["refresh"] = refresh
        refresh(force=False)
        action, acct = curses.wrapper(picker, db, usage, state, handoff)

        with lock:
            cache.update({k: v for k, v in usage.items() if v.get("error") != "not logged in"})
            save_cache(cache)
            save_db(db)

        if action == "quit":
            return None
        if action == "launch":
            return acct
        if action == "add":
            add_account(db)
            input("\nPress enter to return to the picker…")
        if action == "login":
            relogin(db, acct)
            input("\nPress enter to return to the picker…")


def run_picker(args):
    db = load_db()
    acct = pick(db)
    if acct:
        sys.exit(run_session(db, acct, args))


def handoff_last(db):
    try:
        with open(LAST_SESSION) as f:
            h = json.load(f)
    except (OSError, ValueError):
        sys.exit("No session to hand off yet. Launch an agent through `code` first.")
    src = find(db, h["account"])
    name = f"{PROVIDERS[h['provider']]['label']} '{src['name'] if src else h['account']}'"
    acct = pick(db, {"exclude": h["account"], "title": f"Move your last {name} session ({h['cwd']}) to:"})
    if acct:
        sys.exit(run_session(db, acct, [], handoff=h))


# ---------- CLI ----------

HELP = """usage:
  code [-- args...]              open the picker; extra args are passed to the agent
  code add [provider] [name]     link an account (claude, codex, openrouter, grok, cursor, opencode)
  code list                      print accounts and usage
  code login <id>                re-run login (or replace the API key) for an account
  code rm <id>                   remove an account
  code <id> [args...]            launch an account directly (e.g. code claude-work)
  code handoff                   move your last session (with its context) to another account
  code effort [<id> on|off]      show or toggle dynamic reasoning effort (Codex only)

Agents launched through `code` are watched: if the account hits its usage limit, the agent is
closed and you pick another account to continue the same conversation on.
"""


def find(db, key):
    for a in db["accounts"]:
        if a["id"] == key:
            return a
    named = [a for a in db["accounts"] if a["name"] == key]
    return named[0] if len(named) == 1 else None


def cmd_list(db):
    results = {}
    threads = [threading.Thread(target=lambda a=a: results.__setitem__(a["id"], fetch_usage(a))) for a in db["accounts"]]
    for t in threads:
        t.start()
    for t in threads:
        t.join()
    for a in db["accounts"]:
        info = results[a["id"]]
        head = f"{a['id']:<24} {info.get('email') or a.get('email') or '':<32} {info.get('plan') or ''}"
        if info.get("error"):
            print(f"{head}\n    {info['error']}")
        else:
            parts = [f"{w['label']} {w['pct']:.0f}%" + (f" (resets {fmt_reset(w['reset'])})" if w.get("reset") else "")
                     for w in info["windows"]]
            print(f"{head}\n    " + ("   ".join(parts) or info.get("note") or "no limit data"))
    cache = load_cache()
    cache.update(results)
    save_cache(cache)


def cmd_effort(db, argv):
    if len(argv) >= 2:
        a = find(db, argv[0])
        if not a or a["provider"] != "codex":
            sys.exit("auto-effort applies to Codex accounts only (see: code list)")
        a["auto_effort"] = argv[1] == "on"
        save_db(db)
        print(f"auto-effort {'on' if a['auto_effort'] else 'off'} for {a['id']}")
        return
    for a in db["accounts"]:
        if a["provider"] == "codex":
            print(f"{a['id']:<24} auto-effort {'on' if a.get('auto_effort', True) else 'off'}")
    try:
        with open(EFFORT_LOG) as f:
            lines = f.readlines()[-20:]
        print("\nrecent decisions (" + EFFORT_LOG + "):\n" + "".join(lines))
    except OSError:
        print("\nno effort decisions logged yet")


def main():
    argv = sys.argv[1:]
    db = load_db()
    if not argv or argv[0] == "--":
        return run_picker(argv[1:])
    cmd = argv[0]
    if cmd in ("-h", "--help", "help"):
        print(HELP)
    elif cmd == "add":
        add_account(db, argv[1] if len(argv) > 1 else None, " ".join(argv[2:]) or None)
    elif cmd in ("list", "ls"):
        cmd_list(db)
    elif cmd in ("rm", "remove", "login"):
        a = find(db, argv[1]) if len(argv) > 1 else None
        if not a:
            sys.exit("unknown account. Try: code list")
        if cmd == "login":
            relogin(db, a)
        elif not a["home"] and not a.get("keyed"):
            sys.exit("default accounts are your normal logins and can't be removed")
        else:
            remove_account(db, a)
            print(f"removed {a['id']}")
    elif cmd in ("handoff", "switch"):
        handoff_last(db)
    elif cmd == "effort":
        cmd_effort(db, argv[1:])
    elif find(db, cmd):
        sys.exit(run_session(db, find(db, cmd), argv[1:]))
    else:
        print(HELP)
        sys.exit(1)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print()
