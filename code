# ---------- storage ----------
#
# Several `code` processes can run at once (one per terminal), so every write goes through
# mutate(): lock, re-read the file, apply the change, write atomically.

@contextlib.contextmanager
def locked():
    os.makedirs(DATA, mode=0o700, exist_ok=True)
    with open(os.path.join(DATA, ".lock"), "w") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        yield


def read_db():
    try:
        with open(DB) as f:
            db = json.load(f)
    except FileNotFoundError:
        db = {}
    except (OSError, ValueError):
        backup = f"{DB}.corrupt-{int(time.time())}"
        shutil.copy(DB, backup)
        print(f"code: {DB} was unreadable; saved it as {backup} and started fresh", file=sys.stderr)
        db = {}
    db.setdefault("accounts", [])
    db.setdefault("last", None)
    return db


def write_db(db):
    tmp = f"{DB}.{os.getpid()}.tmp"
    with open(tmp, "w") as f:
        json.dump(db, f, indent=2)
    os.chmod(tmp, 0o600)
    os.replace(tmp, DB)


def load_db():
    with locked():
        db = read_db()
        if detect_defaults(db):
            write_db(db)
    return db


def mutate(db, fn):
    """Apply fn to the latest on-disk accounts file, save it, and refresh `db` in place."""
    with locked():
        fresh = read_db()
        result = fn(fresh)
        write_db(fresh)
    db.clear()
    db.update(fresh)
    return result


def update_acct(db, aid, **fields):
    def fn(d):
        for a in d["accounts"]:
            if a["id"] == aid:
                for k, v in fields.items():
                    if v is None:
                        a.pop(k, None)
                    else:
                        a[k] = v
    mutate(db, fn)
    return find(db, aid)


def detect_defaults(db):
    """Adopt logins that already exist on this machine, once each (removed ones stay removed)."""
    seen = set(db.setdefault("seen_defaults", []))
    # a login already used by some account (default home, no API key) must not be adopted a second time
    seen.update(a["provider"] for a in db["accounts"] if not a.get("home") and not a.get("keyed"))
    checks = {
        "codex": lambda: os.path.exists(os.path.join(HOME, ".codex", "auth.json")),
        "claude": lambda: bool(binary_for("claude")),
        "grok": lambda: os.path.exists(os.path.join(HOME, ".grok", "auth.json")),
        "cursor": lambda: bool(keychain_get("cursor-access-token", "cursor-user")),
        "opencode": lambda: os.path.exists(os.path.join(PROVIDERS["opencode"]["default_home"], "opencode", "auth.json")),
    }
    changed = False
    for p in ORDER:
        if p in seen or p not in checks:
            continue
        try:
            found = checks[p]()
        except Exception:
            found = False
        if found:
            db["accounts"].append({"id": f"{p}-default", "provider": p, "name": "default", "home": None})
            seen.add(p)
            changed = True
    if sorted(seen) != sorted(db["seen_defaults"]):
        db["seen_defaults"] = sorted(seen)
        changed = True
    return changed


