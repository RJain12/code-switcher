KEEP_FRESH_STATE = os.path.join(DATA, "keep-fresh.json")
# Claude Code and Codex refresh only an expired access token (about 8h and 10d lifetimes).
# A tiny request through the official CLI after expiry rotates the refresh token before it can lapse.
IDLE_AFTER_EXPIRY = 12 * 3600
KEEP_FRESH_RETRY = 6 * 3600


def jwt_expiry(token):
    import base64
    try:
        payload = token.split(".")[1]
        return json.loads(base64.urlsafe_b64decode(payload + "=" * (-len(payload) % 4))).get("exp")
    except (AttributeError, IndexError, ValueError):
        return None


def access_expiry(acct):
    """(expiry epoch seconds, has refresh token) for OAuth logins; None for key-based ones."""
    if acct["provider"] == "claude" and not acct.get("keyed"):
        creds = claude_creds(acct) or {}
        if creds.get("refreshToken") and creds.get("expiresAt"):
            return creds["expiresAt"] / 1000
    if acct["provider"] == "codex":
        tokens = (codex_auth(acct) or {}).get("tokens") or {}
        if tokens.get("refresh_token"):
            return jwt_expiry(tokens.get("access_token"))
    return None


def account_in_use(acct):
    """True when a running CLI uses this account; rotating its refresh token could strand that process."""
    var = PROVIDERS[acct["provider"]]["env"]
    home = acct.get("home")
    try:
        listing = subprocess.run(["ps", "-Eww", "-o", "command=", "-U", str(os.getuid())],
                                 capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.TimeoutExpired):
        return True
    names = PROVIDERS[acct["provider"]]["bin"]
    for line in listing.splitlines():
        words = line.split()
        if not words or os.path.basename(words[0]) not in {os.path.basename(n) for n in names} | {"node"}:
            continue
        if not any(os.path.basename(n) in line for n in names):
            continue
        uses_home = f" {var}={home}" in f" {line} " if home else f" {var}=" not in f" {line} "
        if uses_home:
            return True
    return False


def keep_fresh_reason(acct, now):
    """Why an account needs a refreshing request now, or None."""
    expiry = access_expiry(acct)
    if expiry is None:
        return None
    idle = now - expiry
    return f"access token expired {idle / 3600:.0f}h ago" if idle > IDLE_AFTER_EXPIRY else None


def keep_fresh_command(acct):
    prompt = "Reply with exactly: OK"
    if acct["provider"] == "claude":
        return [binary_for("claude") or "claude", "-p", prompt, "--model", "haiku", "--max-turns", "1"]
    return [binary_for("codex") or "codex", "exec", "--skip-git-repo-check", "-s", "read-only", prompt]


def cmd_keep_fresh(db, args):
    import tempfile
    dry = "--dry-run" in args
    now = time.time()
    try:
        with open(KEEP_FRESH_STATE) as f:
            state = json.load(f)
    except (OSError, ValueError):
        state = {}
    results = {}
    for acct in db["accounts"]:
        reason = keep_fresh_reason(acct, now)
        if reason is None:
            results[acct["id"]] = {"status": "fresh"}
            continue
        if now - state.get(acct["id"], {}).get("attempted", 0) < KEEP_FRESH_RETRY:
            results[acct["id"]] = {"status": "waiting", "reason": reason}
            continue
        if account_in_use(acct):
            results[acct["id"]] = {"status": "in-use", "reason": reason}
            continue
        if dry:
            results[acct["id"]] = {"status": "would-refresh", "reason": reason}
            continue
        with tempfile.TemporaryDirectory() as scratch:
            try:
                run = subprocess.run(keep_fresh_command(acct), capture_output=True, text=True,
                                     env=env_for(acct), cwd=scratch, timeout=180, stdin=subprocess.DEVNULL)
                ok = run.returncode == 0
            except (OSError, subprocess.TimeoutExpired):
                ok = False
        refreshed = ok and keep_fresh_reason(acct, time.time()) is None
        state[acct["id"]] = {"attempted": now, "refreshed": refreshed}
        results[acct["id"]] = {"status": "refreshed" if refreshed else "failed", "reason": reason}
    if not dry:
        os.makedirs(DATA, exist_ok=True)
        tmp = KEEP_FRESH_STATE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(state, f, indent=2)
        os.replace(tmp, KEEP_FRESH_STATE)
    print(json.dumps(results, indent=2))
    return 1 if any(r["status"] == "failed" for r in results.values()) else 0


# ---------- cross-machine account manifest ----------
#
# OAuth logins rotate their refresh token on use, so a copied login shares one session with its source
# and whichever machine refreshes first signs the other out. Machines therefore exchange API keys only;
# an OAuth account is linked by signing in on each machine, which gives it an independent session.

def key_fingerprint(key):
    return hashlib.sha256(key.encode()).hexdigest()[:12]


def account_identity(acct):
    """Stable identity shared by the same login on different machines, or None when unknown."""
    if acct.get("keyed"):
        key = key_get(acct)
        return "key:" + key_fingerprint(key) if key else None
    if acct["provider"] == "codex":
        import base64
        tokens = (codex_auth(acct) or {}).get("tokens") or {}
        try:
            payload = tokens["id_token"].split(".")[1]
            email = json.loads(base64.urlsafe_b64decode(payload + "=" * (-len(payload) % 4))).get("email")
        except (KeyError, IndexError, ValueError, AttributeError):
            email = None
        return email and f"{email}/{tokens.get('account_id') or ''}"
    if acct["provider"] == "claude":
        if not claude_creds(acct):
            return None
        email = acct.get("email")
        if not email and binary_for("claude"):
            try:
                r = subprocess.run([binary_for("claude"), "auth", "status", "--json"], capture_output=True,
                                   text=True, env=env_for(acct), timeout=20)
                email = json.loads(r.stdout).get("email")
            except (OSError, ValueError, subprocess.TimeoutExpired):
                email = None
        return email
    if acct["provider"] == "cursor":
        return cursor_email(acct) if keychain_get("cursor-access-token", "cursor-user") else None
    return None


def account_login(acct):
    if acct.get("keyed"):
        return "ok" if key_get(acct) else "logged-out"
    expiry = access_expiry(acct)
    if expiry is not None:
        return "ok" if time.time() - expiry < IDLE_AFTER_EXPIRY else "idle"
    if acct["provider"] == "cursor":
        return "ok" if keychain_get("cursor-access-token", "cursor-user") else "logged-out"
    if acct["provider"] in ("grok", "opencode"):
        return "logged-out" if FETCHERS[acct["provider"]](acct).get("error") else "ok"
    return "logged-out"


def cmd_accounts_manifest(db, args):
    if args:
        sys.exit("usage: code accounts-manifest")
    locked = keychain_locked()
    accounts = []
    for acct in db["accounts"]:
        expiry = access_expiry(acct)
        login, identity = account_login(acct), account_identity(acct)
        # API keys and Claude/Cursor browser logins live in the keychain, which SSH sessions cannot read.
        if locked and login != "ok" and (acct.get("keyed") or acct["provider"] in ("claude", "cursor")):
            login, identity = "unknown", None
        accounts.append({"id": acct["id"], "provider": acct["provider"], "name": acct["name"],
                         "keyed": bool(acct.get("keyed")), "model": acct.get("model"),
                         "identity": identity, "login": login,
                         "expires_in": round(expiry - time.time()) if expiry else None})
    print(json.dumps({"version": 1, "machine": socket.gethostname(), "keychain_locked": locked,
                      "generated_at": time.time(), "accounts": accounts}))
    return 0


def cmd_key_export(db, args):
    acct = find(db, args[0]) if len(args) == 1 else None
    if not acct or not acct.get("keyed"):
        sys.exit("usage: code key-export <api-key account>")
    key = key_get(acct)
    if not key:
        sys.exit(f"code: {acct['id']} has no stored key")
    print(json.dumps({"provider": acct["provider"], "name": acct["name"], "model": acct.get("model"), "key": key}))
    return 0


def cmd_key_import(db, args):
    """Register an API-key account from JSON on stdin; an account holding the same key is reused."""
    if args:
        sys.exit("usage: code key-import < account.json")
    spec = json.loads(sys.stdin.read())
    provider, key, name = spec.get("provider"), spec.get("key"), spec.get("name")
    if provider not in ("openrouter", "cursor") or not isinstance(key, str) or not key.strip() \
            or not isinstance(name, str) or not name.strip():
        sys.exit("code: key-import needs provider (openrouter or cursor), name and key")
    key = key.strip()
    unreadable = False
    for acct in db["accounts"]:
        if acct["provider"] == provider and acct.get("keyed"):
            existing = key_get(acct)
            if existing == key:
                print(json.dumps({"id": acct["id"], "status": "exists"}))
                return 0
            unreadable = unreadable or existing is None
    if unreadable and keychain_locked():
        sys.exit("code: this session cannot read the keychain, so it cannot rule out a duplicate; "
                 "the logged-in session will import the key")
    taken = {a["id"] for a in read_db()["accounts"]}
    base = f"{provider}-{slug(name)}"
    aid = next(candidate for candidate in [base] + [f"{base}-{n}" for n in range(2, 100)] if candidate not in taken)
    home = os.path.join(DATA, provider, aid[len(provider) + 1:])
    os.makedirs(home, mode=0o700, exist_ok=True)
    link_shared(provider, home)
    acct = {"id": aid, "provider": provider, "name": aid[len(provider) + 1:], "home": home, "keyed": True}
    if provider == "openrouter":
        acct["model"] = spec.get("model") or None
    key_set(acct, key)
    sync_claude_mcp(acct)
    mutate(db, lambda d: d["accounts"].append(acct))
    print(json.dumps({"id": aid, "status": "added"}))
    return 0


def main():
    argv = sys.argv[1:]
    if argv[:1] in (["-V"], ["--version"], ["version"]):
        print(f"code-switcher {VERSION}")
        return
    if argv[:1] in (["-h"], ["--help"], ["help"]):
        print(HELP)
        return
    if argv[:1] == ["update"]:
        sys.exit(cmd_update(argv[1:]))
    if argv[:1] in (["space"], ["dispatch"]):
        companion = os.path.join(os.path.dirname(os.path.realpath(__file__)), "codespace")
        if not os.path.isfile(companion):
            sys.exit("code: Codespace is missing; reinstall the paired Code/Codespace package")
        forwarded = argv[1:] if argv[0] == "space" else ["t3", "start", *argv[1:]]
        # Pass argv directly so prompts, paths, and stdin retain their exact contents.
        sys.exit(subprocess.call([sys.executable, companion, *forwarded]))
    db = load_db()
    if not argv or argv[0] == "--":
        return run_picker(argv[1:])
    cmd = argv[0]
    if cmd == "add":
        add_account(db, argv[1] if len(argv) > 1 else None, " ".join(argv[2:]) or None)
    elif cmd == "adopt":
        adopt_account(db, argv[1:])
    elif cmd in ("list", "ls"):
        cmd_list(db, argv[1:])
    elif cmd == "thread-export":
        cmd_thread_export(db, argv[1:])
    elif cmd == "thread-sync":
        cmd_thread_sync(db, argv[1:])
    elif cmd == "threads":
        cmd_threads(db, argv[1:])
    elif cmd in ("rm", "remove", "login"):
        a = find(db, argv[1]) if len(argv) > 1 else None
        if not a:
            sys.exit("unknown account. Try: code list")
        if cmd == "login":
            relogin(db, a)
        elif not a["home"] and not a.get("keyed"):
            sys.exit("default accounts are your normal logins and can't be removed")
        else:
            remove_account(db, a)
            print(f"removed {a['id']}")
    elif cmd in ("handoff", "switch"):
        handoff_last(db)
    elif cmd == "effort":
        cmd_effort(db, argv[1:])
    elif cmd == "jev":
        cmd_effort(db, ["jev"] + (argv[1:] or ["status"]))
    elif cmd == "best":
        cmd_best(db, argv[1:])
    elif cmd == "config":
        cmd_config(db, argv[1:])
    elif cmd == "doctor":
        sys.exit(cmd_doctor(db))
    elif cmd == "keep-fresh":
        sys.exit(cmd_keep_fresh(db, argv[1:]))
    elif cmd == "accounts-manifest":
        sys.exit(cmd_accounts_manifest(db, argv[1:]))
    elif cmd == "key-export":
        sys.exit(cmd_key_export(db, argv[1:]))
    elif cmd == "key-import":
        sys.exit(cmd_key_import(db, argv[1:]))
    elif find(db, cmd):
        sys.exit(run_session(db, find(db, cmd), argv[1:]))
    else:
        print(HELP)
        sys.exit(1)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print()
        sys.exit(130)
    except EOFError:
        sys.exit("\ncode: input closed")
