# flags that mean the user is already choosing/resuming a session themselves
SESSION_FLAGS = {
    "claude": {"-r", "--resume", "-c", "--continue", "--session-id", "--fork-session", "-p", "--print"},
    "grok": {"-r", "--resume", "-c", "--continue", "-s", "--session-id", "--fork-session"},
}
GROK_LIMIT = re.compile(rb"usage_limit_reached|usage_pool_exhausted")


def claude_project_dir(home, cwd):
    return os.path.join(home, "projects", re.sub(r"[^A-Za-z0-9]", "-", cwd))


def first_json(path):
    try:
        with open(path) as f:
            return json.loads(f.readline())
    except (OSError, ValueError):
        return {}


def limit_signal(engine, d):
    """Return a reason string if this transcript entry is a usage-limit error."""
    if engine == "claude":
        if d.get("isApiErrorMessage") and d.get("error") in ("rate_limit", "billing_error"):
            return d["error"]
        return None
    p = d.get("payload")
    if not isinstance(p, dict):
        return None
    for blob in (p, p.get("error")):
        if isinstance(blob, dict) and "usage_limit" in json.dumps(blob.get("codex_error_info") or ""):
            return "usage_limit_exceeded"
    return None


def confirm_exhausted(acct, reason):
    if reason in ("billing_error", "usage_limit_exceeded", "usage_limit_reached", "usage_pool_exhausted"):
        return True
    # "rate_limit" can be a transient 429; only switch if a plan window is actually full.
    info = fetch_usage(acct)
    return any(w["pct"] >= 99.5 for w in info.get("windows") or [])


class SessionWatcher:
    """Finds the transcript the child agent is writing and tails it for usage-limit errors."""

    def __init__(self, acct, cwd, start, session_id=None, resumed=False):
        self.acct, self.cwd, self.start, self.session_id = acct, cwd, start, session_id
        self.engine = prov(acct)["engine"]
        self.resumed = resumed
        self.path, self.pos = None, 0
        self.elsewhere = set()

    def _candidates(self):
        home = home_of(self.acct)
        if self.engine == "claude":
            if self.session_id:
                hits = glob.glob(os.path.join(home, "projects", "*", self.session_id + ".jsonl"))
                if hits:
                    return hits
            return glob.glob(os.path.join(claude_project_dir(home, self.cwd), "*.jsonl"))
        if self.engine == "codex":
            days = {dt.date.fromtimestamp(t) for t in (self.start - 86400, self.start, time.time())}
            files = []
            for d in days:
                files += glob.glob(os.path.join(home, "sessions", f"{d:%Y/%m/%d}", "rollout-*.jsonl"))
            out = []
            for f in files:
                if f in self.elsewhere:
                    continue
                if (first_json(f).get("payload") or {}).get("cwd") == self.cwd:
                    out.append(f)
                elif os.path.getsize(f) > 0:
                    self.elsewhere.add(f)
            return out
        if self.engine == "grok" and self.session_id:
            return glob.glob(os.path.join(home, "sessions", "*", self.session_id, "updates.jsonl"))
        return []  # cursor / opencode keep sessions in SQLite; no auto-detection

    def locate(self):
        if not self.path:
            cands = []
            for f in self._candidates():
                try:
                    if os.path.getmtime(f) >= self.start - 2:
                        cands.append(f)
                except OSError:
                    pass
            if cands:
                self.path = max(cands, key=os.path.getmtime)
                if self.engine == "claude":
                    self.session_id = os.path.basename(self.path)[:-len(".jsonl")]
                if self.engine == "grok" and self.resumed:
                    self.pos = os.path.getsize(self.path)  # old entries may contain the previous limit error
        return self.path

    def poll(self):
        if not self.locate():
            return None
        try:
            with open(self.path, "rb") as f:
                f.seek(self.pos)
                data = f.read()
        except OSError:
            return None
        end = data.rfind(b"\n")
        if end < 0:
            return None
        self.pos += end + 1
        chunk = data[:end]
        if self.engine == "grok":
            m = GROK_LIMIT.search(chunk)
            return m.group().decode() if m else None
        found = None
        for line in chunk.splitlines():
            try:
                d = json.loads(line)
            except ValueError:
                continue
            if d.get("type") == "session_meta":
                self.session_id = (d.get("payload") or {}).get("id") or self.session_id
            try:
                ts = iso_ts(d.get("timestamp"))
            except (ValueError, AttributeError):
                ts = None
            if ts and ts < self.start - 5:
                continue  # history from a resumed session, not this run
            found = limit_signal(self.engine, d) or found
        return found


def reset_terminal():
    # The agent was killed mid-TUI; undo alt screen, hidden cursor, mouse/paste/keyboard modes.
    sys.stdout.write("\x1b[?1049l\x1b[?25h\x1b[?1000l\x1b[?1002l\x1b[?1003l\x1b[?1006l\x1b[?2004l\x1b[<u\x1b[>4;0m\r\n")
    sys.stdout.flush()
    subprocess.run(["stty", "sane"], stdin=sys.stdin)


def stop_child(child):
    child.terminate()
    try:
        child.wait(timeout=5)
    except subprocess.TimeoutExpired:
        child.kill()
        child.wait()
    reset_terminal()


def fresh_session_args(acct, args):
    """Pick the session id up front where the CLI allows it, so the watcher knows which log to tail."""
    engine = prov(acct)["engine"]
    if engine in SESSION_FLAGS and not any(a.split("=")[0] in SESSION_FLAGS[engine] for a in args):
        sid = str(uuid.uuid4())
        return [("--session-id" if engine == "claude" else "-s"), sid] + args, sid
    return args, None


class NotInstalled(Exception):
    def __init__(self, acct):
        super().__init__(f"{label(acct)} isn't installed. Install it with:\n  {prov(acct)['install']}")


def session_state_key(acct, session_id):
    return hashlib.sha256(json.dumps([os.path.realpath(home_of(acct)), session_id]).encode()).hexdigest()


def write_session_state(path, value):
    import tempfile
    directory = os.path.dirname(path)
    os.makedirs(directory, mode=0o700, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".state-", dir=directory)
    try:
        with os.fdopen(fd, "w") as output:
            json.dump(value, output)
        os.replace(tmp, path)
    finally:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(tmp)


@contextlib.contextmanager
def account_session_lock(acct, importing=False):
    directory = os.path.join(DATA, "session-locks")
    os.makedirs(directory, mode=0o700, exist_ok=True)
    path = os.path.join(directory, session_state_key(acct, "account") + ".lock")
    fd = os.open(path, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        # Shared leases allow parallel native conversations. Import takes an
        # exclusive lease so no supervised CLI can write that account's history.
        try:
            fcntl.flock(fd, (fcntl.LOCK_EX if importing else fcntl.LOCK_SH) | fcntl.LOCK_NB)
        except BlockingIOError:
            raise ValueError("this account has a running Code session or a handoff in progress") from None
        yield fd
    finally:
        os.close(fd)


def completed_session_path(acct, session_id):
    return os.path.join(DATA, "completed-sessions", session_state_key(acct, session_id) + ".json")


def transcript_fingerprint(path):
    stat = os.stat(path)
    return [stat.st_dev, stat.st_ino, stat.st_size, stat.st_mtime_ns]


def record_completed_session(acct, session):
    if not session.get("session_id") or not session.get("path"):
        return
    record = dict(session, fingerprint=transcript_fingerprint(session["path"]), version=1)
    write_session_state(completed_session_path(acct, session["session_id"]), record)


def completed_session_thread(acct, session_id):
    with open(completed_session_path(acct, session_id)) as source:
        record = json.load(source)
    if (record.get("version") != 1 or record.get("session_id") != session_id
            or os.path.realpath(record.get("home", "")) != os.path.realpath(home_of(acct))
            or record.get("fingerprint") != transcript_fingerprint(record["path"])):
        raise ValueError("session changed since Code observed its exit; stop it again before handoff")
    return {"id": session_id, "path": record["path"], "cwd": record["cwd"],
            "title": record.get("title") or "Code session"}


def supervise(db, acct, args, handoff=None, cwd=None, session_id=None):
    with account_session_lock(acct) as lease_fd:
        result = supervise_locked(db, acct, args, handoff, cwd, session_id, lease_fd)
    schedule_t3_sync()
    return result


def t3_auto_import_enabled():
    try:
        with open(os.path.expanduser("~/.config/codespace/config.json")) as source:
            return json.load(source).get("t3_auto_import") is True
    except (OSError, ValueError, AttributeError):
        return False


def schedule_t3_sync():
    if not t3_auto_import_enabled():
        return
    try:
        subprocess.Popen([sys.executable, os.path.realpath(__file__), "thread-sync", "--auto"],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True, close_fds=True)
    except OSError:
        pass  # The maintenance job will retry the durable completion receipts.


def sync_completed_threads(db, status_only=False, automatic=False, limit=10):
    enabled = t3_auto_import_enabled()
    if automatic and not enabled:
        return {"enabled": False, "sessions": []}
    os.makedirs(DATA, mode=0o700, exist_ok=True)
    fd = os.open(os.path.join(DATA, "t3-sync.lock"), os.O_CREAT | os.O_RDWR, 0o600)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return {"enabled": enabled, "status": "busy", "sessions": []}
        accounts = {a["id"]: a for a in db["accounts"] if a["provider"] in ("codex", "claude")}
        rows, attempted = [], 0
        def last_attempt(path):
            try:
                return os.stat(os.path.join(DATA, "t3-handoffs", os.path.basename(path))).st_mtime_ns
            except OSError:
                return 0
        for path in sorted(glob.glob(os.path.join(DATA, "completed-sessions", "*.json")), key=last_attempt):
            try:
                with open(path) as source:
                    record = json.load(source)
                acct = accounts.get(record.get("account"))
                session_id = record.get("session_id")
                if not acct or not session_id or path != completed_session_path(acct, session_id):
                    continue
                state_path = os.path.join(DATA, "t3-handoffs", session_state_key(acct, session_id) + ".json")
                try:
                    with open(state_path) as source:
                        state = json.load(source)
                except (OSError, ValueError):
                    state = {}
                if state.get("fingerprint") != record["fingerprint"]:
                    state = {"status": "pending", "fingerprint": record["fingerprint"]}
                if (not status_only and state.get("status") != "imported" and attempted < limit
                        and state.get("retryAfter", 0) <= time.time()):
                    attempted += 1
                    try:
                        with account_session_lock(acct, importing=True):
                            thread = completed_session_thread(acct, session_id)
                            payload = {"account": acct["id"], "sessionId": session_id,
                                       "cwd": thread["cwd"], "sourceHome": os.path.realpath(home_of(acct))}
                            companion = os.path.join(os.path.dirname(os.path.realpath(__file__)), "codespace")
                            result = subprocess.run([sys.executable, companion, "t3", "_receive-native"],
                                                    input=json.dumps(payload), capture_output=True, text=True, timeout=90)
                            if result.returncode:
                                raise RuntimeError("T3 unavailable or selected-session import rejected; check connection and provider mapping")
                            response = json.loads(result.stdout)
                            if response.get("importedCount", 0) != 1:
                                raise RuntimeError("T3 did not confirm the selected session import")
                            state.update(status="imported", projectId=response["projectId"], importedAt=time.time())
                            state.pop("error", None)
                            state.pop("retryAfter", None)
                    except (OSError, ValueError, KeyError, RuntimeError, subprocess.TimeoutExpired) as error:
                        state.update(status="pending", error=str(error), retryAfter=time.time() + 300)
                    write_session_state(state_path, state)
                rows.append({"account": acct["id"], "sessionId": session_id, **state})
            except (OSError, ValueError, KeyError, TypeError):
                rows.append({"receipt": os.path.basename(path), "status": "invalid-receipt"})
        return {"enabled": enabled, "sessions": rows}
    finally:
        os.close(fd)


def cmd_thread_sync(db, args):
    if args not in ([], ["--status"], ["--auto"]):
        raise SystemExit("usage: code thread-sync [--status | --auto]")
    print(json.dumps(sync_completed_threads(db, status_only=args == ["--status"],
                                           automatic=args == ["--auto"]), indent=2))


def supervise_locked(db, acct, args, handoff=None, cwd=None, session_id=None, lease_fd=None):
    binary = binary_for(acct["provider"])
    if not binary:
        raise NotInstalled(acct)
    want = handoff["cwd"] if handoff else cwd
    cwd = want if want and os.path.isdir(want) else os.getcwd()
    resumed = bool(session_id)
    if handoff:
        args, session_id, resumed = prepare_handoff(acct, handoff)
    elif not session_id:
        args, session_id = fresh_session_args(acct, args)
    proxy = None
    launch_env = env_for(acct)
    native_jev = jev_key(db) if auto_effort_ok(acct, args) else None
    selected_ares_model = ares_model(acct, args) if native_jev else None
    if native_jev and selected_ares_model:
        ensure_ares_installed()
        binary, prefix, launch_env = ares_launch(acct, native_jev)
        if not binary:
            sys.exit("Jev's in-chat display needs Node 22+.")
        # Ares activates its checkpoint only for its logical model selections.
        args = prefix + ["-m", selected_ares_model] + without_model_arg(args)
    elif auto_effort_ok(acct, args):
        proxy = EffortProxy(acct["id"], jev_key(db), acct.get("effort_range"))
        args = proxy.codex_args() + args
    mutate(db, lambda d: d.update(last=acct["id"]))
    sync_claude_mcp(acct)

    start = time.time()
    watcher = SessionWatcher(acct, cwd, start, session_id, resumed)
    # The child owns the terminal; keep Ctrl+C / Ctrl+\ from killing the supervisor too.
    saved = {s: signal.signal(s, lambda *_: None) for s in (signal.SIGINT, signal.SIGQUIT)}
    hit, child = None, None

    def forward(signum, _frame):  # terminal closed or `kill`: pass it on so the agent can save and exit
        if child and child.poll() is None:
            child.send_signal(signum)
    for sig in (signal.SIGTERM, signal.SIGHUP):
        saved[sig] = signal.signal(sig, forward)
    try:
        child = subprocess.Popen([binary] + args, env=launch_env, cwd=cwd,
                                 pass_fds=(lease_fd,) if lease_fd is not None else ())
        while child.poll() is None:
            try:
                child.wait(timeout=2)
                break
            except subprocess.TimeoutExpired:
                pass
            reason = watcher.poll()
            if reason and confirm_exhausted(acct, reason):
                hit = reason
                time.sleep(3)  # let the agent's own "limit reached" message show
                if child.poll() is None:
                    stop_child(child)
                break
        if not hit:
            reason = watcher.poll()
            if reason and confirm_exhausted(acct, reason):
                hit = reason
    finally:
        for s, h in saved.items():
            signal.signal(s, h)
        if proxy:
            proxy.close()

    session = {"provider": acct["provider"], "account": acct["id"], "home": home_of(acct), "path": watcher.path,
               "session_id": watcher.session_id, "cwd": cwd, "ended": time.time()}
    if watcher.path:
        os.makedirs(DATA, mode=0o700, exist_ok=True)
        with open(LAST_SESSION, "w") as f:
            json.dump(session, f)
    if child.poll() is not None and watcher.path:
        try:
            record_completed_session(acct, session)
        except (OSError, ValueError) as error:
            print(f"Code could not record T3 handoff readiness: {error}", file=sys.stderr)
    rc = child.returncode
    return (128 - rc if rc < 0 else rc), hit, session


def notify(title, text):
    if os.environ.get("CODE_NO_NOTIFY"):
        return
    if sys.platform == "darwin" and shutil.which("osascript"):
        script = f"display notification {json.dumps(text)} with title {json.dumps(title)}"
        subprocess.run(["osascript", "-e", script], capture_output=True, timeout=5)
    elif shutil.which("notify-send"):
        subprocess.run(["notify-send", title, text], capture_output=True, timeout=5)


def run_session(db, acct, args, handoff=None, cwd=None, session_id=None):
    while True:
        try:
            rc, hit, session = supervise(db, acct, args, handoff, cwd, session_id)
        except NotInstalled as e:
            print(e, file=sys.stderr)
            return 127
        if not hit:
            return rc
        resets = fetch_usage(acct).get("resets") if acct["provider"] == "codex" else None
        title = f"{label(acct)} '{acct['name']}' hit its usage limit"
        if resets:
            title += f" (it has {resets} banked reset{'s' if resets != 1 else ''}: spend one in Codex to keep going)"
        try:
            notify("code: usage limit reached", f"{label(acct)} '{acct['name']}' is out. Pick where to continue.")
        except Exception:
            pass
        nxt = pick(db, {"exclude": acct["id"], "title": title + ". Continue this conversation on:",
                        "auto_seconds": db.get("auto_handoff_seconds")})
        if not nxt:
            print("Session saved. Continue it on another account later with: code handoff")
            return rc
        acct, args, handoff, cwd, session_id = nxt, [], session, None, None


def prompt_args(target, prompt):
    """Args that start `target` interactively with `prompt` as the first message; returns (args, session_id)."""
    engine = prov(target)["engine"]
    if engine == "opencode":
        return ["--prompt", prompt], None
    args, sid = fresh_session_args(target, [])
    return args + [prompt], sid


def prepare_handoff(target, h):
    """Returns (args, session_id, resumed) that start `target` with the handed-off conversation."""
    src_engine = PROVIDERS[h["provider"]]["engine"]
    dst_engine = prov(target)["engine"]
    if src_engine == dst_engine == "claude" and h.get("path") and h.get("session_id"):
        src_dir = os.path.dirname(h["path"])
        dst_dir = os.path.join(home_of(target), "projects", os.path.basename(src_dir))
        os.makedirs(dst_dir, exist_ok=True)
        if os.path.realpath(dst_dir) != os.path.realpath(src_dir):
            shutil.copy2(h["path"], dst_dir)
            side = os.path.join(src_dir, h["session_id"])  # subagent logs, saved tool outputs
            if os.path.isdir(side):
                shutil.copytree(side, os.path.join(dst_dir, h["session_id"]), dirs_exist_ok=True)
        return ["--resume", h["session_id"], CONTINUE_NATIVE], h["session_id"], True
    if src_engine == dst_engine == "grok" and h.get("path") and h.get("session_id"):
        src_dir = os.path.dirname(h["path"])  # sessions/<cwd>/<id>/
        rel = os.path.relpath(src_dir, h.get("home") or PROVIDERS[h["provider"]]["default_home"])
        dst_dir = os.path.join(home_of(target), rel)
        if os.path.realpath(dst_dir) != os.path.realpath(src_dir):
            shutil.copytree(src_dir, dst_dir, dirs_exist_ok=True)
        return ["--resume", h["session_id"]], h["session_id"], True

    src = f"{PROVIDERS[h['provider']]['label']} (account '{h['account']}')"
    path = export_transcript(h, src)
    prompt = CONTINUE_TRANSCRIPT.format(src=src, path=path, raw=h.get("path") or "unavailable")
    args, sid = prompt_args(target, prompt)
    return args, sid, False


# ---------- transcript export ----------

NOISE = ("<environment_context>", "<user_instructions>", "# AGENTS.md", "<permissions", "<INSTRUCTIONS>",
         "<command-name>", "<local-command-stdout>", "<local-command-caveat>")


def clip(s, n):
    s = s.strip()
    return s if len(s) <= n else s[:n] + f"\n… [{len(s) - n} more characters trimmed]"


def content_parts(content):
    if isinstance(content, str):
        return [("text", content)]
    out = []
    for c in content or []:
        if not isinstance(c, dict):
            continue
        t = c.get("type")
        if t in ("text", "input_text", "output_text"):
            out.append(("text", c.get("text", "")))
        elif t == "tool_use":
            out.append(("call", f"{c.get('name')} {json.dumps(c.get('input'), ensure_ascii=False)}"))
        elif t == "tool_result":
            r = c.get("content")
            if isinstance(r, list):
                r = "\n".join(x.get("text", "") for x in r if isinstance(x, dict) and x.get("type") == "text")
            out.append(("result", str(r or "")))
        elif t in ("image", "input_image"):
            out.append(("text", "[image]"))
    return out


def jsonl(path):
    with open(path, errors="replace") as f:
        for line in f:
            try:
                yield json.loads(line)
            except ValueError:
                continue


def claude_entries(path):
    for d in jsonl(path):
        if d.get("isSidechain") or d.get("isMeta"):
            continue
        if d.get("type") == "summary":
            yield "note", "Earlier summary: " + d.get("summary", "")
        if d.get("type") not in ("user", "assistant"):
            continue
        parts = content_parts((d.get("message") or {}).get("content"))
        if d.get("isApiErrorMessage"):
            yield "note", "API error: " + " ".join(s for _, s in parts)
            continue
        for kind, s in parts:
            yield (d["type"] if kind == "text" else kind), s


def codex_entries(path):
    for d in jsonl(path):
        p = d.get("payload")
        if not isinstance(p, dict):
            continue
        if d.get("type") != "response_item":
            if limit_signal("codex", d):
                err = p.get("error") if isinstance(p.get("error"), dict) else p
                yield "note", "Usage limit: " + str(err.get("message", ""))
            continue
        pt = p.get("type")
        if pt == "message" and p.get("role") in ("user", "assistant"):
            for _, s in content_parts(p.get("content")):
                yield p["role"], s
        elif pt in ("function_call", "custom_tool_call"):
            yield "call", f"{p.get('name')} {p.get('arguments') or p.get('input') or ''}"
        elif pt in OUTPUT_TYPES:
            out = p.get("output")
            yield "result", out if isinstance(out, str) else json.dumps(out, ensure_ascii=False)
        elif pt == "local_shell_call":
            yield "call", "shell " + json.dumps(p.get("action"), ensure_ascii=False)


def grok_entries(path):
    """Grok's chat_history.jsonl holds chat-completions style messages."""
    hist = os.path.join(os.path.dirname(path), "chat_history.jsonl")
    for d in jsonl(hist if os.path.exists(hist) else path):
        m = d.get("message") if isinstance(d.get("message"), dict) else d
        role = m.get("role")
        if role in ("user", "assistant"):
            for kind, s in content_parts(m.get("content")):
                yield (role if kind == "text" else kind), s
            for tc in m.get("tool_calls") or []:
                fn = tc.get("function") or {}
                yield "call", f"{fn.get('name')} {fn.get('arguments', '')}"
        elif role == "tool":
            yield "result", " ".join(s for _, s in content_parts(m.get("content")))


ENTRIES = {"claude": claude_entries, "codex": codex_entries, "grok": grok_entries}


def export_transcript(h, src):
    os.makedirs(HANDOFFS, mode=0o700, exist_ok=True)
    out = os.path.join(HANDOFFS, f"{time.strftime('%Y%m%d-%H%M%S')}-{h['account']}.md")
    entries = []
    gen = ENTRIES.get(PROVIDERS[h["provider"]]["engine"])
    if gen and h.get("path") and os.path.exists(h["path"]):
        entries = list(gen(h["path"]))
    lines = [f"# Conversation handed off from {src}", "",
             f"- Working directory: `{h['cwd']}`", f"- Raw session log: `{h.get('path')}`", ""]
    last_role = None
    for kind, s in entries:
        if kind in ("user", "assistant"):
            s = re.sub(r"<system-reminder>.*?</system-reminder>", "", s, flags=re.S).strip()
            if not s or s.startswith(NOISE):
                continue
            if kind != last_role:
                lines += ["", f"## {kind.title()}", ""]
                last_role = kind
            lines += [s, ""]
        elif kind == "call":
            lines += ["**Tool call:**", "````", clip(s, 2000), "````", ""]
        elif kind == "result":
            lines += ["**Tool result:**", "````", clip(s, 4000), "````", ""]
        else:
            lines += [f"> {clip(s, 1000)}", ""]
    if not entries and h.get("path") and os.path.exists(h["path"]):
        with open(h["path"], errors="replace") as f:
            lines += ["The transcript format wasn't recognized, so here is the raw session log:", "", "````",
                      clip(f.read(), 200_000), "````"]
    elif not entries:
        lines.append("_(No transcript could be read; check the raw session log above.)_")
    with open(out, "w") as f:
        f.write("\n".join(lines))
    os.chmod(out, 0o600)
    return out


# ---------- recent threads ----------

def fmt_ago(ts):
    d = max(0, time.time() - (ts or 0))
    return "now" if d < 60 else f"{int(d // 60)}m" if d < 3600 else f"{int(d // 3600)}h" if d < 86400 else f"{int(d // 86400)}d"


def short_path(p):
    return ("~" + p[len(HOME):]) if p and p.startswith(HOME) else (p or "")


def one_line(s, n=90):
    s = re.sub(r"<[^>]+>[\s\S]*?</[^>]+>", " ", s or "")
    s = " ".join(s.split())
    return s[:n - 1] + "…" if len(s) > n else s


def read_edges(path, head=65536, tail=262144):
    """First and last chunk of a (possibly huge) JSONL file, as parsed rows."""
    size = os.path.getsize(path)
    with open(path, "rb") as f:
        first = f.read(head)
        if size > head:
            f.seek(max(head, size - tail))
            last = f.read()
        else:
            last = b""
    rows = []
    for chunk, drop_first in ((first, False), (last, True)):
        lines = chunk.split(b"\n")
        if drop_first and lines:
            lines = lines[1:]  # likely cut mid-line
        for line in lines:
            try:
                rows.append(json.loads(line))
            except ValueError:
                pass
    return rows


def claude_threads(acct, n):
    files = sorted(glob.glob(os.path.join(home_of(acct), "projects", "*", "*.jsonl")), key=os.path.getmtime, reverse=True)
    out = []
    for f in files[:n * 3]:
        rows = read_edges(f)
        cwd = next((r.get("cwd") for r in rows if r.get("cwd")), None)
        first = None
        titles = {}
        for r in rows:
            t = r.get("type")
            if t in ("custom-title", "ai-title"):
                titles[t] = r.get("customTitle") or r.get("aiTitle") or r.get("title")
            elif t == "last-prompt":
                titles["last"] = r.get("lastPrompt")
            elif t == "user" and not first and not r.get("isMeta") and not r.get("isSidechain"):
                text = " ".join(x for k, x in content_parts((r.get("message") or {}).get("content")) if k == "text")
                if text.strip() and not text.lstrip().startswith(NOISE):
                    first = text
        title = titles.get("custom-title") or titles.get("ai-title") or first or titles.get("last")
        if not title:
            continue  # empty or tool-only session
        out.append({"id": os.path.basename(f)[:-len(".jsonl")], "title": one_line(title), "cwd": cwd,
                    "updated": os.path.getmtime(f), "path": f})
        if len(out) == n:
            break
    return out


def codex_threads(acct, n):
    import sqlite3
    dbs = sorted(glob.glob(os.path.join(home_of(acct), "state_*.sqlite")),
                 key=lambda p: int(re.findall(r"\d+", os.path.basename(p))[-1]))
    if dbs:
        try:
            con = sqlite3.connect(f"file:{dbs[-1]}?mode=ro", uri=True, timeout=1)
            try:
                rows = con.execute(
                    "select id, rollout_path, updated_at, cwd, title, first_user_message from threads "
                    "where archived = 0 and source in ('cli', 'vscode') order by updated_at desc limit ?", (n,)).fetchall()
            finally:
                con.close()
            return [{"id": r[0], "path": r[1], "updated": r[2], "cwd": r[3], "title": one_line(r[4] or r[5] or "(untitled)")}
                    for r in rows]
        except sqlite3.Error:
            pass  # schema changed: fall back to the rollout files
    files = sorted(glob.glob(os.path.join(home_of(acct), "sessions", "*", "*", "*", "rollout-*.jsonl")), reverse=True)
    out = []
    for f in files[:n * 3]:
        meta, first = {}, None
        for r in read_edges(f, tail=0):
            p = r.get("payload") or {}
            if r.get("type") == "session_meta":
                meta = p
            elif r.get("type") == "response_item" and p.get("type") == "message" and p.get("role") == "user" and not first:
                text = item_text(p)
                if text.strip() and not text.lstrip().startswith(NOISE):
                    first = text
        if meta.get("id") and first:
            out.append({"id": meta["id"], "path": f, "cwd": meta.get("cwd"), "updated": os.path.getmtime(f),
                        "title": one_line(first)})
        if len(out) == n:
            break
    return out


def grok_threads(acct, n):
    dirs = sorted(glob.glob(os.path.join(home_of(acct), "sessions", "*", "*", "")), key=os.path.getmtime, reverse=True)
    out = []
    for d in dirs[:n]:
        summary = {}
        try:
            with open(os.path.join(d, "summary.json")) as f:
                summary = json.load(f)
        except (OSError, ValueError):
            pass
        first = next((s for k, s in grok_entries(os.path.join(d, "updates.jsonl")) if k == "user"), None)
        title = summary.get("title") or summary.get("summary") or first
        out.append({"id": os.path.basename(os.path.dirname(d)), "path": os.path.join(d, "updates.jsonl"),
                    "cwd": summary.get("cwd"), "updated": os.path.getmtime(d), "title": one_line(title or "(untitled)")})
    return out


THREADS = {"claude": claude_threads, "codex": codex_threads, "grok": grok_threads}


def recent_threads(acct, n=5):
    try:
        return THREADS.get(prov(acct)["engine"], lambda a, k: [])(acct, n)
    except Exception:
        return []


def resume_args(acct, thread):
    engine = prov(acct)["engine"]
    if engine == "codex":
        return ["resume", thread["id"]]
    return ["--resume", thread["id"]]


def thread_handoff(acct, thread):
    return {"provider": acct["provider"], "account": acct["id"], "home": home_of(acct), "path": thread.get("path"),
            "session_id": thread["id"], "cwd": thread.get("cwd") or os.getcwd(), "ended": time.time()}


# ---------- picker UI ----------

def fmt_reset(ts):
    if not ts:
        return ""
    delta = ts - time.time()
    if delta <= 0:
        return "now"
    if delta < 3600:
        return f"{int(delta // 60)}m"
    if delta < 86400:
        return f"{int(delta // 3600)}h{int(delta % 3600 // 60):02d}m"
    return dt.datetime.fromtimestamp(ts).strftime("%a %-I%p").replace("AM", "am").replace("PM", "pm")


def headroom(info):
    """Lower is better; used for the 'best pick' marker."""
    if not info or info.get("error") or not info.get("windows"):
        return 1e9
    return max(w["pct"] for w in info["windows"])


def picker(stdscr, db, usage, state, handoff=None):
    """Returns (mode, account, thread): mode is new|resume|handoff|add|login|quit."""
    curses.curs_set(0)
    curses.use_default_colors()
    for i, c in enumerate((curses.COLOR_GREEN, curses.COLOR_YELLOW, curses.COLOR_RED, curses.COLOR_CYAN,
                           curses.COLOR_MAGENTA, curses.COLOR_BLUE), 1):
        curses.init_pair(i, c, -1)
    GREEN, YELLOW, RED, CYAN, MAG, BLUE = (curses.color_pair(i) for i in range(1, 7))
    DIM, BOLD, REV = curses.A_DIM, curses.A_BOLD, curses.A_REVERSE
    PCOLOR = {"claude": MAG, "codex": GREEN, "openrouter": CYAN, "grok": 0, "cursor": YELLOW, "opencode": BLUE}
    installed = {p: bool(binary_for(p)) for p in PROVIDERS}
    threads = state.setdefault("threads", {})
    stdscr.clear()  # full repaint: don't leave the previous screen's text behind
    stdscr.timeout(250)

    def visible():
        return [a for a in db["accounts"] if not handoff or a["id"] != handoff["exclude"]]

    def threads_of(a):
        if handoff:
            return []  # choosing a target account, not a thread
        if a["id"] not in threads:
            threads[a["id"]] = recent_threads(a)
        return threads[a["id"]]

    accts = visible()
    ids = [a["id"] for a in accts]
    ai = ids.index(db["last"]) if db.get("last") in ids and not handoff else 0
    ti = -1  # -1 = the account row itself, else index into its threads
    auto_sel = bool(handoff)  # in handoff mode, follow the best account until the user moves
    message, scroll = "", 0
    deadline = time.time() + handoff["auto_seconds"] if handoff and handoff.get("auto_seconds") else None

    def color_for(p):
        return GREEN if p < 60 else YELLOW if p < 85 else RED

    while True:
        accts = visible()
        ai = min(ai, max(0, len(accts) - 1))
        h, w = stdscr.getmaxyx()
        stdscr.erase()

        def put(y, x, text, attr=0):
            if 0 <= y < h and x < w - 1:
                try:
                    stdscr.addstr(y, x, text[: max(0, w - 1 - x)], attr)
                except curses.error:
                    pass
            return x + len(text)

        if h < 8 or w < 40:
            put(0, 0, "terminal too small for code; enlarge it (q quits)")
            stdscr.refresh()
            if stdscr.getch() in (ord("q"), 27):
                return ("quit", None, None)
            continue

        best = min(accts, key=lambda a: headroom(usage.get(a["id"])), default=None)
        best_id = best["id"] if best and headroom(usage.get(best["id"])) < 100 else None
        if auto_sel and best_id:
            ai, ti = [a["id"] for a in accts].index(best_id), -1
        jev_on = bool((db.get("jev") or {}).get("enabled"))

        # header
        if handoff:
            put(0, 2, handoff["title"], BOLD | YELLOW)
            put(1, 2, "Enter continues with the full conversation · q stops here", DIM)
            top = 3
            keys = "enter continue  a add  l login  r refresh  q quit"
        else:
            x = put(0, 2, "code", BOLD | CYAN)
            x = put(0, x + 1, "↑↓ pick an account or a recent thread", DIM)
            put(0, x + 3, f"jev {'on' if jev_on else 'off'}", (GREEN if jev_on else DIM) | BOLD)
            top = 2
            keys = "enter new/resume  h hand off  J jev  e effort  a add  d remove  l login  r refresh  q quit"
        status = "refreshing…" if state["loading"] else (state.get("update") or "")
        if status:
            put(0, max(2, w - len(status) - 2), status, DIM if state["loading"] else YELLOW)
        put(h - 1, 2, keys, DIM)
        if deadline and best_id:
            left = deadline - time.time()
            if left <= 0:
                return ("new", next(a for a in accts if a["id"] == best_id), None)
            put(h - 2, 2, f"Continuing on {best_id} in {int(left) + 1}s. Press any key to choose yourself.", GREEN | BOLD)
        elif message:
            put(h - 2, 2, message, YELLOW)

        # build lines: (segments, selectable?) for every account; threads under the selected one
        lines, sel_line = [], 0
        name_w = max([len(a["name"]) for a in accts] + [7])
        ind = 15
        for i, a in enumerate(accts):
            info = usage.get(a["id"])
            on_acct = i == ai and ti == -1
            if on_acct:
                sel_line = len(lines)
            segs = [(1, "›" if on_acct else " ", BOLD | CYAN), (3, f"{label(a):<10}", PCOLOR[a["provider"]] | BOLD),
                    (14, f"{a['name']:<{name_w}}", BOLD if i == ai else 0)]
            x = 16 + name_w
            email = (info or {}).get("email") or a.get("email") or ""
            plan = (info or {}).get("plan") or ""
            extra = []
            if email:
                extra.append((email, DIM))
            if plan:
                extra.append((f"[{plan}]", DIM))
            if a["provider"] == "codex" and a.get("auto_effort", True):
                extra.append(("⚡auto-effort" + ("+jev" if jev_on else ""), CYAN))
            if a["id"] == best_id and len(accts) > 1:
                extra.append(("★ most headroom", GREEN))
            for text, attr in extra:
                segs.append((x, text, attr))
                x += len(text) + 1
            lines.append(segs)
            if not installed[a["provider"]]:
                usage_segs = [(ind, f"not installed · {prov(a)['install']}", RED)]
            elif info is None:
                usage_segs = [(ind, "loading usage…", DIM)]
            elif info.get("error"):
                usage_segs = [(ind, info["error"], RED)]
            elif not info.get("windows"):
                usage_segs = [(ind, info.get("note") or "no limit data", DIM)]
            else:
                usage_segs, x = [], ind
                for win in info["windows"]:
                    pct = win["pct"]
                    filled = int(round(min(pct, 100) / 10))
                    r = fmt_reset(win.get("reset"))
                    for text, attr in ((f"{win['label']:>4} ", DIM), ("█" * filled, color_for(pct)),
                                       ("░" * (10 - filled), DIM), (f" {pct:3.0f}%", color_for(pct) | BOLD),
                                       (f" resets {r}" if r else "", DIM)):
                        usage_segs.append((x, text, attr))
                        x += len(text)
                    x += 3
                if info.get("extra"):
                    usage_segs.append((x, "+extra usage", CYAN))
                    x += 15
                if info.get("resets"):
                    usage_segs.append((x, f"↺ {info['resets']} reset{'s' if info['resets'] != 1 else ''} banked", CYAN))
            lines.append(usage_segs)
            if i == ai and installed[a["provider"]]:
                ts = threads_of(a)
                for j, t in enumerate(ts):
                    on = ti == j
                    if on:
                        sel_line = len(lines)
                    where = short_path(t.get("cwd"))
                    lines.append([(5, "›" if on else " ", BOLD | CYAN), (7, f"{fmt_ago(t['updated']):>4}", DIM),
                                  (13, t["title"][: max(10, w - 16 - min(len(where), 28))], (REV if on else 0)),
                                  (max(14, w - 2 - min(len(where), 28)), where[-28:], DIM)])
                if not ts and not handoff and prov(a)["engine"] in THREADS:
                    lines.append([(7, "no recent threads", DIM)])
            lines.append([])
        if not accts:
            lines.append([(4, "No other accounts. Press 'a' to add one." if handoff else "No accounts yet. Press 'a' to add one.", 0)])

        room = h - top - 2
        scroll = min(max(scroll, sel_line - room + 3), max(0, sel_line - 1))
        scroll = max(0, min(scroll, max(0, len(lines) - room)))
        if scroll:
            put(top - 1, w - 10, "↑ more", DIM)
        for k, segs in enumerate(lines[scroll:scroll + room]):
            for x, text, attr in segs:
                put(top + k, x, text, attr)
        if scroll + room < len(lines):
            put(h - 3, w - 10, "↓ more", DIM)
        stdscr.refresh()

        k = stdscr.getch()
        if k == -1:
            continue
        deadline, message = None, ""
        cur = accts[ai] if accts else None
        ts = threads_of(cur) if cur and installed[cur["provider"]] else []
        if k in (ord("q"), 27):
            return ("quit", None, None)
        if k in (curses.KEY_UP, ord("k")) and accts:
            auto_sel = False
            if ti >= 0:
                ti -= 1
            else:
                ai = (ai - 1) % len(accts)
        elif k in (curses.KEY_DOWN, ord("j")) and accts:
            auto_sel = False
            if ti + 1 < len(ts):
                ti += 1
            else:
                ai, ti = (ai + 1) % len(accts), -1
        elif ord("1") <= k <= ord("9") and k - ord("1") < len(accts):
            return ("new", accts[k - ord("1")], None)
        elif k in (10, 13, curses.KEY_ENTER) and accts:
            return ("resume", cur, ts[ti]) if ti >= 0 else ("new", cur, None)
        elif k == ord("h") and accts and not handoff:
            t = ts[ti] if ti >= 0 else (ts[0] if ts else None)
            if not t:
                message = f"'{cur['name']}' has no recent thread to hand off."
            elif len(db["accounts"]) < 2:
                message = "Add another account first (press a), then hand the thread to it."
            else:
                return ("handoff", cur, t)
        elif k == ord("J") and not handoff:
            if jev_on:
                mutate(db, lambda d: d.update(jev={**(d.get("jev") or {}), "enabled": False}))
                message = "Jev off: auto-effort uses the local heuristic."
            else:
                acct_id = (db.get("jev") or {}).get("account") or next(
                    (a["id"] for a in db["accounts"] if a["provider"] == "openrouter"), None)
                if not acct_id and not os.environ.get("OPENROUTER_API_KEY"):
                    message = "Jev needs an OpenRouter key: press a and add an OpenRouter account first."
                else:
                    mutate(db, lambda d: d.update(jev={"enabled": True, "account": acct_id}))
                    message = f"Jev on (key from {acct_id or 'OPENROUTER_API_KEY'}); applies to new Codex sessions."
        elif k == ord("a"):
            return ("add", None, None)
        elif k == ord("l") and accts:
            return ("login", cur, None)
        elif k == ord("r"):
            threads.clear()
            state["refresh"]()
        elif k == ord("e") and accts and not handoff:
            if cur["provider"] != "codex":
                message = "Auto-effort is Codex-only: other providers lose the prompt cache when effort changes."
            else:
                a = update_acct(db, cur["id"], auto_effort=not cur.get("auto_effort", True))
                message = f"Auto-effort {'on' if a['auto_effort'] else 'off'} for '{a['name']}'."
        elif k == ord("d") and accts and not handoff and ti == -1:
            if not cur["home"] and not cur.get("keyed"):
                message = "Default accounts are your normal logins and can't be removed here."
                continue
            put(h - 2, 2, f"Remove {label(cur)} '{cur['name']}' and delete its login? (y/N) ", RED | BOLD)
            stdscr.timeout(-1)
            ans = stdscr.getch()
            stdscr.timeout(250)
            if ans in (ord("y"), ord("Y")):
                remove_account(db, cur)
                message = f"Removed '{cur['name']}'."


def version_tuple(v):
    return tuple(int(x) for x in re.findall(r"\d+", v)[:3])


def check_for_update(cache, state, lock):
    """Once a day, see if a newer code-switcher is published; show a hint in the picker."""
    info = cache.get("_update") or {}
    if time.time() - info.get("checked", 0) > 86400:
        try:
            req = urllib.request.Request(f"https://raw.githubusercontent.com/{REPO}/main/code",
                                         headers={"Range": "bytes=0-4095"})
            with urllib.request.urlopen(req, timeout=5) as r:
                m = re.search(r'VERSION = "([^"]+)"', r.read().decode("utf-8", "replace"))
            info = {"checked": time.time(), "latest": m.group(1) if m else None}
        except Exception:
            info = {"checked": time.time(), "latest": info.get("latest")}
        with lock:
            cache["_update"] = info
    latest = info.get("latest")
    if latest and version_tuple(latest) > version_tuple(VERSION):
        state["update"] = f"v{latest} available · run code update"


def pick(db, handoff=None):
    """Picker loop. Normal mode returns (mode, account, thread) or None; handoff mode returns an account or None."""
    while True:
        cache = load_cache()
        usage = {a["id"]: cache[a["id"]] for a in db["accounts"] if a["id"] in cache}
        state = {"loading": set(), "update": None}
        emails = {}
        lock = threading.Lock()

        def worker(a):
            info = fetch_usage(a)
            with lock:
                usage[a["id"]] = info
                state["loading"].discard(a["id"])
                if info.get("email") and not a.get("email") and a["provider"] != "openrouter":
                    emails[a["id"]] = info["email"]

        def refresh(force=True):
            for a in db["accounts"]:
                fresh = a["id"] in usage and time.time() - usage[a["id"]].get("fetched", 0) < CACHE_TTL
                if a["id"] in state["loading"] or (fresh and not force):
                    continue
                state["loading"].add(a["id"])
                threading.Thread(target=worker, args=(a,), daemon=True).start()

        state["refresh"] = refresh
        refresh(force=False)
        threading.Thread(target=check_for_update, args=(cache, state, lock), daemon=True).start()
        mode, acct, thread = curses.wrapper(picker, db, usage, state, handoff)

        with lock:
            cache.update({k: v for k, v in usage.items() if v.get("error") != "not logged in"})
            save_cache(cache)
            if emails:
                mutate(db, lambda d: [a.update(email=emails[a["id"]]) for a in d["accounts"] if a["id"] in emails])

        if mode == "quit":
            return None
        if mode in ("new", "resume", "handoff"):
            if binary_for(acct["provider"]) or ensure_installed(acct["provider"]):
                return acct if handoff else (mode, acct, thread)
            input("\nPress enter to return to the picker…")
        if mode == "add":
            add_account(db)
            input("\nPress enter to return to the picker…")
        if mode == "login":
            relogin(db, acct)
            input("\nPress enter to return to the picker…")


def need_tty():
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        sys.exit("code: the picker needs an interactive terminal. Use `code list` or `code <account-id>` instead.")


def run_picker(args):
    need_tty()
    db = load_db()
    choice = pick(db)
    if not choice:
        return
    mode, acct, thread = choice
    if mode == "new":
        sys.exit(run_session(db, acct, args))
    if mode == "resume":
        sys.exit(run_session(db, acct, resume_args(acct, thread) + args, cwd=thread.get("cwd"), session_id=thread["id"]))
    h = thread_handoff(acct, thread)
    target = pick(db, {"exclude": acct["id"], "title": f"Continue “{one_line(thread['title'], 50)}” on:"})
    if target:
        sys.exit(run_session(db, target, [], handoff=h))


def handoff_last(db):
    need_tty()
    try:
        with open(LAST_SESSION) as f:
            h = json.load(f)
    except (OSError, ValueError):
        sys.exit("No session to hand off yet. Launch an agent through `code` first.")
    src = find(db, h["account"])
    name = f"{PROVIDERS[h['provider']]['label']} '{src['name'] if src else h['account']}'"
    acct = pick(db, {"exclude": h["account"], "title": f"Move your last {name} session ({h['cwd']}) to:"})
    if acct:
        sys.exit(run_session(db, acct, [], handoff=h))


