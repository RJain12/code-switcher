def session_import_payload(acct, thread, model=None):
    """Export display history; native provider files remain authoritative for resume."""
    provider = acct["provider"]
    if provider not in ("claude", "codex"):
        raise ValueError("T3 import currently supports native Claude and Codex accounts")
    source = os.path.realpath(thread["path"])
    home = os.path.realpath(home_of(acct))
    if os.path.commonpath([source, home]) != home:
        raise ValueError("session transcript is outside this account's home")
    before = os.stat(source)
    messages, seen = [], set()
    detected_model = None
    for number, row in enumerate(jsonl(source)):
        if not isinstance(row, dict):
            continue
        stamp = row.get("timestamp")
        message = None
        if provider == "codex":
            payload = row.get("payload")
            if not isinstance(payload, dict):
                continue
            if row.get("type") == "turn_context":
                detected_model = payload.get("model") or detected_model
            if row.get("type") == "session_meta" and payload.get("id") != thread["id"]:
                raise ValueError("native session ID does not match the selected thread")
            if row.get("type") == "response_item" and payload.get("type") == "message":
                message = payload
        elif not row.get("isSidechain") and not row.get("isMeta"):
            if row.get("sessionId") and row["sessionId"] != thread["id"]:
                raise ValueError("native session ID does not match the selected thread")
            if row.get("type") in ("user", "assistant"):
                message = row.get("message")
                if isinstance(message, dict):
                    detected_model = message.get("model") or detected_model
        if not isinstance(message, dict) or message.get("role") not in ("user", "assistant", "system"):
            continue
        text = "\n".join(value for kind, value in content_parts(message.get("content")) if kind == "text")
        if not text.strip():
            continue
        try:
            date = dt.datetime.fromisoformat(str(stamp).replace("Z", "+00:00"))
            if date.tzinfo is None:
                raise ValueError("timestamp has no timezone")
        except ValueError:
            raise ValueError(f"session message {number} has no valid timestamp") from None
        # Claude UUID identifies a transcript row; Codex response items often
        # have no ID, so use their append-only row position.
        identity = str(row.get("uuid") or message.get("id") or f"row-{number}")
        if identity in seen:
            continue
        seen.add(identity)
        messages.append({"id": identity, "role": message["role"], "text": text,
                         "createdAt": date.astimezone(dt.timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")})
        if len(messages) > 10000:
            raise ValueError("session exceeds T3's 10,000-message import limit")
    after = os.stat(source)
    if (before.st_size, before.st_mtime_ns, before.st_ino) != (after.st_size, after.st_mtime_ns, after.st_ino):
        raise ValueError("session changed during export; stop the CLI before importing")
    selected_model = model or detected_model
    if not selected_model or selected_model.startswith("<"):
        raise ValueError("session has no usable model; specify --model")
    cwd = thread.get("cwd")
    if not cwd or not os.path.isabs(cwd) or not os.path.isdir(cwd):
        raise ValueError("session workspace must exist on this host")
    return {"version": 1, "provider": provider, "sessionId": thread["id"], "sourceHome": home,
            "cwd": cwd, "title": thread.get("title") or "Code session", "model": selected_model,
            "state": "stopped", "messages": messages}


def cmd_thread_export(db, argv):
    import argparse
    parser = argparse.ArgumentParser(prog="code thread-export")
    parser.add_argument("account")
    parser.add_argument("session_id")
    parser.add_argument("--model")
    parser.add_argument("--deliver-t3", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--deliver-native-t3", action="store_true", help=argparse.SUPPRESS)
    state = parser.add_mutually_exclusive_group(required=True)
    state.add_argument("--completed", action="store_true",
                       help="require Code to have observed this session exit and its transcript to be unchanged")
    state.add_argument("--stopped", action="store_true",
                        help="assert that this native CLI session has stopped before transferring ownership to T3")
    args = parser.parse_args(argv)
    if args.deliver_native_t3 and (not args.completed or args.deliver_t3):
        parser.error("native handoff requires --completed and cannot use the preview bridge")
    acct = find(db, args.account)
    if not acct:
        parser.error("unknown account; run code list")
    try:
        with account_session_lock(acct, importing=True):
            thread = completed_session_thread(acct, args.session_id) if args.completed else next(
                (t for t in recent_threads(acct, 100) if t["id"] == args.session_id), None)
            if not thread:
                parser.error("session not found among this account's 100 recent threads")
            if args.deliver_native_t3:
                payload = json.dumps({"account": acct["id"], "sessionId": thread["id"],
                                      "cwd": thread["cwd"], "sourceHome": os.path.realpath(home_of(acct))})
            else:
                payload = json.dumps(session_import_payload(acct, thread, args.model), ensure_ascii=False)
            if args.deliver_t3 or args.deliver_native_t3:
                companion = os.path.join(os.path.dirname(os.path.realpath(__file__)), "codespace")
                result = subprocess.run([sys.executable, companion, "t3", "_receive-native" if args.deliver_native_t3 else "_receive"],
                                        input=payload.encode(), timeout=75)
                if result.returncode:
                    raise SystemExit(result.returncode)
            else:
                print(payload)
    except (OSError, ValueError, KeyError, subprocess.TimeoutExpired) as error:
        parser.error(str(error))



