def self_update():
    me = os.path.realpath(os.path.abspath(__file__))
    repo = os.path.dirname(me)
    if os.path.isfile(os.path.join(repo, "release.json")):
        return subprocess.run([sys.executable, os.path.join(repo, "codespace"), "update"]).returncode == 0
    if os.path.isdir(os.path.join(repo, ".git")):
        dirty = subprocess.run(["git", "-C", repo, "status", "--porcelain", "--untracked-files=no"],
                               capture_output=True, text=True).stdout.strip()
        if dirty:
            print(f"code-switcher: {repo} has local changes; skipping `git pull`", flush=True)
            return None
        return subprocess.run(["git", "-C", repo, "pull", "--ff-only", "--quiet"]).returncode == 0
    with urllib.request.urlopen(f"https://raw.githubusercontent.com/{REPO}/main/code", timeout=20) as r:
        src = r.read()
    compile(src, me, "exec")  # refuse to install something that doesn't even parse
    m = re.search(rb'VERSION = "([^"]+)"', src)
    latest = m.group(1).decode() if m else "?"
    if latest == VERSION:
        print(f"code-switcher is up to date ({VERSION})")
        return True
    tmp = me + ".new"
    with open(tmp, "wb") as f:
        f.write(src)
    os.chmod(tmp, os.stat(me).st_mode)
    os.replace(tmp, me)
    print(f"code-switcher updated {VERSION} -> {latest}")
    return True


def cmd_update(argv):
    results = []
    if "--providers" not in argv:
        print("== code-switcher", flush=True)
        try:
            results.append(("code-switcher", self_update()))
        except Exception as e:
            print(f"self-update failed: {e}")
            results.append(("code-switcher", False))
    if "--self" not in argv:
        done = set()
        for p in UPDATE_ARGS:
            b = binary_for(p)
            if not b or os.path.realpath(b) in done:
                continue
            done.add(os.path.realpath(b))
            print(f"\n== {PROVIDERS[p]['label']} ({b})", flush=True)
            try:
                ok = subprocess.run([b] + UPDATE_ARGS[p], timeout=600).returncode == 0
            except (subprocess.TimeoutExpired, OSError) as e:
                print(e)
                ok = False
            if not ok:
                print(f"   if that didn't work, reinstall with: {PROVIDERS[p]['install']}")
            results.append((PROVIDERS[p]["label"], ok))
    mark = {True: "✓", False: "✗", None: "–"}
    print("\n" + "  ".join(f"{mark[ok]} {name}" for name, ok in results))
    return 1 if any(ok is False for _, ok in results) else 0


