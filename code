def cmd_best(db, argv):
    provider = argv[0] if argv and argv[0] in PROVIDERS else None
    args = argv[1:] if provider else argv
    cands = [a for a in db["accounts"] if (not provider or a["provider"] == provider) and binary_for(a["provider"])]
    if not cands:
        sys.exit("no installed accounts" + (f" for {provider}" if provider else ""))
    results = fetch_all(cands)
    best = min(cands, key=lambda a: headroom(results[a["id"]]))
    if headroom(results[best["id"]]) >= 100:
        sys.exit("every matching account is at its limit (or reports no usage); pick one with `code`")
    print(f"code: launching {best['id']} ({100 - headroom(results[best['id']]):.0f}% left)")
    sys.exit(run_session(db, best, args))


def effort_stats():
    try:
        with open(EFFORT_LOG) as f:
            lines = f.readlines()
    except OSError:
        return None, []
    jev_calls = sum(1 for l in lines if "[Jev, lease" in l)
    cost = sum(float(x) for l in lines for x in re.findall(r"\$([0-9.]+)\]", l))
    tin = sum(int(x) for l in lines for x in re.findall(r"tokens in=(\d+)", l))
    tcached = sum(int(x) for l in lines for x in re.findall(r"cached=(\d+)", l))
    changes = sum(1 for l in lines if "(was " in l)
    summary = (f"{changes} effort changes, {jev_calls} Jev calls (${cost:.4f}), "
               f"cache hit rate {100 * tcached / tin:.0f}% of {tin:,} input tokens" if tin else
               f"{changes} effort changes, {jev_calls} Jev calls (${cost:.4f}), no token data yet")
    return summary, lines[-20:]


