def binary_for(provider):
    for b in PROVIDERS[provider]["bin"]:
        path = shutil.which(os.path.expanduser(b))
        if path:
            return path
    return None


# ---------- storage ----------

def load_db():
    try:
        with open(DB) as f:
            db = json.load(f)
    except (OSError, ValueError):
        db = {"accounts": [], "last": None}
    if detect_defaults(db):
        save_db(db)
    return db


def detect_defaults(db):
    """Adopt logins that already exist on this machine, once each (removed ones stay removed)."""
    seen = set(db.setdefault("seen_defaults", []))
    if not seen:  # accounts created by older versions
        seen.update(a["provider"] for a in db["accounts"] if not a.get("home"))
    checks = {
        "codex": lambda: os.path.exists(os.path.join(HOME, ".codex", "auth.json")),
        "claude": lambda: bool(binary_for("claude")),
        "grok": lambda: os.path.exists(os.path.join(HOME, ".grok", "auth.json")),
        "cursor": lambda: bool(keychain_get("cursor-access-token", "cursor-user")),
        "opencode": lambda: os.path.exists(os.path.join(PROVIDERS["opencode"]["default_home"], "opencode", "auth.json")),
    }
    changed = False
    for p in ORDER:
        if p in seen or p not in checks:
            continue
        try:
            found = checks[p]()
        except Exception:
            found = False
        if found:
            db["accounts"].append({"id": f"{p}-default", "provider": p, "name": "default", "home": None})
            seen.add(p)
            changed = True
    if sorted(seen) != sorted(db["seen_defaults"]):
        db["seen_defaults"] = sorted(seen)
        changed = True
    return changed


def save_db(db):
    os.makedirs(DATA, mode=0o700, exist_ok=True)
    tmp = DB + ".tmp"
    with open(tmp, "w") as f:
        json.dump(db, f, indent=2)
    os.replace(tmp, DB)


def load_cache():
    try:
        with open(CACHE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_cache(cache):
    os.makedirs(DATA, mode=0o700, exist_ok=True)
    with open(CACHE, "w") as f:
        json.dump(cache, f)
    os.chmod(CACHE, 0o600)


def home_of(acct):
    return acct["home"] or prov(acct)["default_home"]


# ---------- secrets (API keys live in the macOS keychain, or a 0600 file elsewhere) ----------

def keychain_get(service, account):
    if sys.platform != "darwin":
        return None
    r = subprocess.run(["security", "find-generic-password", "-s", service, "-a", account, "-w"],
                       capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 and r.stdout.strip() else None


def key_path(acct):
    return os.path.join(acct["home"], ".code-switcher-key")


def key_get(acct):
    if sys.platform == "darwin":
        return keychain_get(KEYCHAIN_SERVICE, acct["id"])
    try:
        with open(key_path(acct)) as f:
            return f.read().strip() or None
    except OSError:
        return None


def key_set(acct, key):
    if sys.platform == "darwin":
        subprocess.run(["security", "add-generic-password", "-U", "-s", KEYCHAIN_SERVICE, "-a", acct["id"], "-w", key],
                       check=True, capture_output=True)
    else:
        fd = os.open(key_path(acct), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(key)


def key_del(acct):
    if sys.platform == "darwin":
        subprocess.run(["security", "delete-generic-password", "-s", KEYCHAIN_SERVICE, "-a", acct["id"]], capture_output=True)


def env_for(acct):
    p = prov(acct)
    env = dict(os.environ)
    if acct["home"]:
        env[p["env"]] = acct["home"]
    elif not p.get("keep_env_for_default"):
        env.pop(p["env"], None)
    if acct["provider"] == "openrouter":
        env.update(ANTHROPIC_BASE_URL="https://openrouter.ai/api", ANTHROPIC_AUTH_TOKEN=key_get(acct) or "",
                   ANTHROPIC_API_KEY="")
        if acct.get("model"):
            env["ANTHROPIC_MODEL"] = acct["model"]
    if acct["provider"] == "cursor" and acct.get("keyed"):
        env["CURSOR_API_KEY"] = key_get(acct) or ""
    return env


# ---------- usage ----------

def http_json(url, headers, body=None):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, headers=headers, data=data)
    with urllib.request.urlopen(req, timeout=10) as r:
        return json.loads(r.read())


def iso_ts(s):
    if not s:
        return None
    return dt.datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp()


def claude_creds(acct):
    service = "Claude Code-credentials"
    if acct["home"]:
        service += "-" + hashlib.sha256(unicodedata.normalize("NFC", acct["home"]).encode()).hexdigest()[:8]
    r = subprocess.run(["security", "find-generic-password", "-s", service, "-w"], capture_output=True, text=True)
    if r.returncode == 0 and r.stdout.strip():
        return json.loads(r.stdout).get("claudeAiOauth")
    path = os.path.join(home_of(acct), ".credentials.json")
    if os.path.exists(path):
        with open(path) as f:
            return json.load(f).get("claudeAiOauth")
    return None


def fetch_claude(acct):
    c = claude_creds(acct)
    if not c or not c.get("accessToken"):
        return {"error": "not logged in"}
    if c.get("expiresAt") and c["expiresAt"] / 1000 < time.time():
        return {"error": "token expired, launch once to refresh", "plan": c.get("subscriptionType")}
    u = http_json("https://api.anthropic.com/api/oauth/usage", {
        "Authorization": "Bearer " + c["accessToken"],
        "anthropic-beta": "oauth-2025-04-20",
        "User-Agent": "claude-code/code-switcher",
    })
    windows = []
    for key, lbl in (("five_hour", "5h"), ("seven_day", "wk"), ("seven_day_opus", "opus")):
        w = u.get(key)
        if w and w.get("utilization") is not None:
            windows.append({"label": lbl, "pct": float(w["utilization"]), "reset": iso_ts(w.get("resets_at"))})
    out = {"plan": c.get("subscriptionType"), "windows": windows}
    if (u.get("extra_usage") or {}).get("is_enabled"):
        out["extra"] = True
    email = acct.get("email")
    if not email:
        r = subprocess.run([binary_for("claude") or "claude", "auth", "status", "--json"],
                           capture_output=True, text=True, env=env_for(acct), timeout=20)
        try:
            email = json.loads(r.stdout).get("email")
        except ValueError:
            pass
    out["email"] = email
    return out


def codex_auth(acct):
    try:
        with open(os.path.join(home_of(acct), "auth.json")) as f:
