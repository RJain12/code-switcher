def find(db, key):
    for a in db["accounts"]:
        if a["id"] == key:
            return a
    named = [a for a in db["accounts"] if a["name"] == key]
    return named[0] if len(named) == 1 else None


def fetch_all(accts):
    results = {}
    threads = [threading.Thread(target=lambda a=a: results.__setitem__(a["id"], fetch_usage(a))) for a in accts]
    for t in threads:
        t.start()
    for t in threads:
        t.join()
    cache = load_cache()
    cache.update(results)
    save_cache(cache)
    return results


