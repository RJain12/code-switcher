def fetch_codex(acct):
    auth = codex_auth(acct)
    if not auth:
        return {"error": "not logged in"}
    t = auth.get("tokens") or {}
    if not t.get("access_token"):
        return {"error": "API-key auth (no plan limits)" if auth.get("OPENAI_API_KEY") else "not logged in"}
    try:
        u = http_json("https://chatgpt.com/backend-api/wham/usage", {
            "Authorization": "Bearer " + t["access_token"],
            "ChatGPT-Account-Id": t.get("account_id", ""),
            "User-Agent": "codex-cli",
        })
    except urllib.error.HTTPError as e:
        if e.code == 401:
            return {"error": "token expired, launch once to refresh"}
        raise
    rl = u.get("rate_limit") or {}
    windows = []
    for key in ("primary_window", "secondary_window"):
        w = rl.get(key)
        if not w:
            continue
        secs = w.get("limit_window_seconds") or 0
        lbl = "5h" if secs and secs <= 6 * 3600 else ("wk" if secs >= 6 * 86400 else f"{round(secs / 3600)}h")
        windows.append({"label": lbl, "pct": float(w.get("used_percent") or 0), "reset": w.get("reset_at")})
    windows.sort(key=lambda w: {"5h": 0}.get(w["label"], 1))
    out = {"plan": u.get("plan_type"), "email": u.get("email"), "windows": windows}
    cr = u.get("credits") or {}
    if cr.get("has_credits") or cr.get("unlimited"):
        out["extra"] = True
    banked = u.get("rate_limit_reset_credits") or {}
    resets = banked.get("applicable_available_count", banked.get("available_count"))
    if isinstance(resets, int):
        out["resets"] = resets
    return out


def fetch_openrouter(acct):
    key = key_get(acct)
    if not key:
        return {"error": "no API key stored, press l to add one"}
    hdr = {"Authorization": "Bearer " + key}
    try:
        d = http_json("https://openrouter.ai/api/v1/key", hdr).get("data") or {}
    except urllib.error.HTTPError as e:
        return {"error": "API key rejected" if e.code in (401, 403) else f"HTTP {e.code}"}
    windows, plan = [], []
    if d.get("limit"):
        lim, rem = float(d["limit"]), d.get("limit_remaining")
        used = lim - float(rem) if rem is not None else float(d.get("usage") or 0)
        windows.append({"label": {"daily": "day", "weekly": "wk", "monthly": "mo"}.get(d.get("limit_reset"), "key"),
                        "pct": 100 * used / lim, "reset": None})
        plan.append(f"${lim - used:.2f} of ${lim:.0f} key limit left")
    try:
        c = http_json("https://openrouter.ai/api/v1/credits", hdr).get("data") or {}
        total, used = float(c.get("total_credits") or 0), float(c.get("total_usage") or 0)
        if total > 0:
            windows.append({"label": "bal", "pct": 100 * used / total, "reset": None})
            plan.append(f"${total - used:.2f} credits left")
    except (urllib.error.URLError, ValueError):
        pass
    if d.get("is_free_tier"):
        plan.append("free tier")
    out = {"plan": ", ".join(plan) or f"${float(d.get('usage') or 0):.2f} used", "windows": windows}
    if acct.get("model"):
        out["email"] = acct["model"]
    return out


