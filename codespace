#!/usr/bin/env python3
"""One local-first entry point for Code, Space, and trusted Macs."""
import json
import os
from pathlib import Path
import shutil
import socket
import subprocess
import sys
import tempfile
import time

CONFIG = Path.home() / ".config" / "codespace" / "config.json"
CATALOG = Path.home() / "Space" / ".codespace" / "machines"
CATALOG_CACHE = Path.home() / ".config" / "codespace" / "machines.json"


def config():
    try:
        data = json.loads(CONFIG.read_text())
        if isinstance(data, dict):
            return data
    except (OSError, ValueError):
        pass
    return {}


def require(name):
    sibling = Path(__file__).resolve().parent / name
    binary = str(sibling) if name == "code" and sibling.is_file() and os.access(sibling, os.X_OK) else shutil.which(name)
    if not binary:
        raise SystemExit(f"codespace: {name} is not installed on this Mac")
    return binary


def sync(args):
    if args not in ([], ["status"]):
        raise SystemExit("usage: codespace sync [status]")
    uri = config().get("sync_uri")
    if uri and (not isinstance(uri, str) or not uri.startswith("gs://") or any(c.isspace() for c in uri)):
        raise SystemExit("codespace: sync_uri must be a gs:// path")
    if not uri and not os.path.ismount(CATALOG.parents[1]):
        raise SystemExit("codespace: mount Space before syncing (`space mount`)")
    gcloud = shutil.which("gcloud") or "/opt/homebrew/bin/gcloud"
    cloud_python = "/opt/homebrew/bin/python3" if Path("/opt/homebrew/bin/python3").exists() else (
        shutil.which("python3") or sys.executable
    )
    cloud_env = dict(os.environ, CLOUDSDK_PYTHON=cloud_python)
    if not args:
        settings = config()
        host = socket.gethostname()
        accounts_path = Path.home() / ".code-accounts" / "accounts.json"
        try:
            accounts = json.loads(accounts_path.read_text()).get("accounts", [])
        except (OSError, ValueError):
            accounts = []
        profiles = [{key: account[key] for key in ("id", "provider", "name") if key in account}
                    for account in accounts]
        t3_id_path = Path.home() / ".t3" / "userdata" / "environment-id"
        try:
            t3_id = t3_id_path.read_text().strip()[:200]
        except OSError:
            t3_id = None
        record = {"version": 1, "machine": host, "alias": settings.get("self_alias"),
                  "ssh_host": settings.get("ssh_host"), "profiles": profiles,
                  "t3_environment_id": t3_id, "space": bool(shutil.which("space")),
                  "updated_at": time.time()}
        if uri:
            with tempfile.NamedTemporaryFile(mode="w", suffix=".json", delete=False) as output:
                json.dump(record, output, indent=2)
                temporary = output.name
            try:
                subprocess.run([gcloud, "storage", "cp", temporary,
                                uri.rstrip("/") + "/" + host + ".json", "-q"],
                               check=True, timeout=45, env=cloud_env, capture_output=True, text=True)
            finally:
                Path(temporary).unlink(missing_ok=True)
        else:
            CATALOG.mkdir(parents=True, exist_ok=True)
            target = CATALOG / (host + ".json")
            temporary = target.with_suffix(".tmp")
            temporary.write_text(json.dumps(record, indent=2) + "\n")
            temporary.replace(target)
    machines = []
    if uri:
        listed = subprocess.run([gcloud, "storage", "ls", uri.rstrip("/") + "/"],
                                capture_output=True, text=True, timeout=30, env=cloud_env)
        paths = [line for line in listed.stdout.splitlines() if line.endswith(".json")] if listed.returncode == 0 else []
    else:
        paths = list(CATALOG.glob("*.json")) if CATALOG.exists() else []
    for path in paths:
        try:
            if uri:
                content = subprocess.run([gcloud, "storage", "cat", str(path)],
                                         capture_output=True, text=True, check=True, timeout=30,
                                         env=cloud_env).stdout
            else:
                content = path.read_text()
            record = json.loads(content)
            if record.get("version") == 1:
                machines.append(record)
        except (OSError, ValueError, subprocess.SubprocessError):
            continue
    machines.sort(key=lambda item: item.get("alias") or item.get("machine") or "")
    CATALOG_CACHE.parent.mkdir(parents=True, exist_ok=True)
    CATALOG_CACHE.write_text(json.dumps(machines, indent=2) + "\n")
    CATALOG_CACHE.chmod(0o600)
    print(json.dumps(machines, indent=2))
    return 0


T3_RPC_SCRIPT = r"""
const chunks = [];
for await (const chunk of process.stdin) chunks.push(chunk);
const input = JSON.parse(Buffer.concat(chunks).toString());
let ws;
const timer = setTimeout(() => fail("T3 RPC timed out"), 60000);
function fail(message) {
  clearTimeout(timer);
  if (ws) ws.close();
  process.stderr.write(message + "\n");
  process.exit(1);
}
try {
  if (typeof WebSocket !== "function") fail("T3 native RPC requires Node 22 or newer");
  const response = await fetch(input.base + "/api/auth/websocket-ticket", {
    method: "POST", headers: {Authorization: "Bearer " + input.token},
    redirect: "manual", signal: AbortSignal.timeout(15000),
  });
  if (!response.ok) fail("T3 ticket request failed (HTTP " + response.status + ")");
  const ticket = (await response.json()).ticket;
  if (typeof ticket !== "string" || !ticket) fail("T3 returned an invalid WebSocket ticket");
  const url = new URL(input.base + "/ws");
  url.protocol = url.protocol === "https:" ? "wss:" : "ws:";
  url.searchParams.set("wsTicket", ticket);
  ws = new WebSocket(url);
  let finished = false;
  ws.addEventListener("open", () => ws.send(JSON.stringify({
    _tag: "Request", id: "1", tag: input.method, payload: input.payload, headers: [],
  })));
  ws.addEventListener("error", () => fail("T3 WebSocket connection failed"));
  ws.addEventListener("close", () => { if (!finished) fail("T3 closed the connection before replying"); });
  ws.addEventListener("message", event => {
    try {
      if (typeof event.data !== "string" || event.data.length > 32 * 1024 * 1024) fail("Invalid or oversized T3 response");
      const decoded = JSON.parse(event.data);
      for (const message of Array.isArray(decoded) ? decoded : [decoded]) {
        if (message._tag === "Ping") { ws.send(JSON.stringify({_tag: "Pong"})); continue; }
        if (message._tag === "Defect" || message._tag === "ClientProtocolError") fail("T3 rejected the RPC protocol");
        if (message._tag !== "Exit" || String(message.requestId) !== "1") continue;
        if (message.exit?._tag !== "Success") fail("T3 RPC failed: " + JSON.stringify(message.exit?.cause ?? []));
        finished = true;
        clearTimeout(timer);
        process.stdout.write(JSON.stringify(message.exit.value) + "\n");
        ws.close();
      }
    } catch { fail("Could not decode the T3 RPC response"); }
  });
} catch { fail("Could not connect to T3"); }
"""


def t3(args):
    """Call the T3 instance on the execution host; never relocate native logins."""
    import urllib.error
    import urllib.parse
    import urllib.request
    if args and args[0] == "import":
        export_args = args[1:]
        if "--stopped" not in export_args and "--completed" not in export_args:
            export_args = [*export_args, "--completed"]
        return subprocess.call([require("code"), "thread-export", *export_args, "--deliver-t3"])
    native = args == ["scan"] or (len(args) == 2 and args[0] == "import-project")
    if args != ["_receive"] and not native:
        raise SystemExit("usage: codespace t3 import <account> <session-id> [--stopped] [--model MODEL]")
    settings = config()
    base = settings.get("t3_url", "http://127.0.0.1:3773")
    if not isinstance(base, str):
        raise SystemExit("codespace: t3_url must be a URL")
    url = urllib.parse.urlsplit(base)
    if (url.scheme not in ("http", "https") or not url.hostname or url.username or url.password
            or url.query or url.fragment or url.path not in ("", "/")
            or (url.scheme == "http" and url.hostname not in ("127.0.0.1", "localhost", "::1"))):
        raise SystemExit("codespace: T3 requires HTTPS or a loopback HTTP URL without credentials")
    token = os.environ.get("CODESPACE_T3_TOKEN")
    if not token:
        token_path = Path(settings.get("t3_token_file", str(CONFIG.parent / "t3-token"))).expanduser()
        try:
            info = token_path.stat()
            if info.st_mode & 0o077 or info.st_uid != os.getuid():
                raise SystemExit("codespace: T3 token file must be owned by you and private (chmod 600)")
            token = token_path.read_text().strip()
        except OSError:
            raise SystemExit("codespace: configure CODESPACE_T3_TOKEN or a private t3_token_file from `t3 auth session issue --token-only`") from None
    if not token or any(c.isspace() for c in token):
        raise SystemExit("codespace: invalid T3 session token")
    if native:
        method = "agentSessions.scan" if args == ["scan"] else "agentSessions.import"
        payload = {} if args == ["scan"] else {"projectId": args[1]}
        try:
            return subprocess.run([require("node"), "--input-type=module", "-e", T3_RPC_SCRIPT],
                                  input=json.dumps({"base": base.rstrip("/"), "token": token,
                                                    "method": method, "payload": payload}).encode(),
                                  timeout=65).returncode
        except subprocess.TimeoutExpired:
            raise SystemExit("codespace: native T3 RPC timed out") from None
    payload = sys.stdin.buffer.read(32 * 1024 * 1024 + 1)
    if len(payload) > 32 * 1024 * 1024:
        raise SystemExit("codespace: T3 history exceeds the 32 MiB transport limit")
    # A redirect must never carry the bearer credential to another origin.
    class NoRedirect(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, req, fp, code, msg, headers, newurl):
            return None
    request = urllib.request.Request(base.rstrip("/") + "/api/codespace/import", data=payload,
                                     headers={"Authorization": "Bearer " + token, "Content-Type": "application/json"}, method="POST")
    try:
        with urllib.request.build_opener(NoRedirect).open(request, timeout=60) as response:
            imported = json.load(response)
    except urllib.error.HTTPError as error:
        if error.code == 404:
            raise SystemExit("codespace: this T3 host does not have the Codespace import bridge installed") from None
        if error.code in (401, 403):
            raise SystemExit("codespace: T3 session is expired, revoked, or lacks orchestration permission; issue a new session token") from None
        try:
            detail = json.loads(error.read(8192)).get("error", "Import failed")
        except (ValueError, AttributeError):
            detail = "Import failed"
        raise SystemExit(f"codespace: T3 HTTP {error.code}: {detail}") from None
    except (urllib.error.URLError, TimeoutError, ValueError) as error:
        raise SystemExit(f"codespace: T3 import could not finish ({type(error).__name__}); retrying the same session is safe") from None
    print(json.dumps(imported, indent=2))
    return 0


def dispatch(argv):
    if not argv or argv[0] in ("code", "local"):
        args = argv[1:] if argv else []
        return subprocess.call([require("code"), *args])

    command, *args = argv
    if command in ("-h", "--help", "help"):
        print("""codespace [code args]       start Code locally
codespace on <host> [args]    start Code on a trusted Mac over SSH
codespace space [args]        run the Space CLI on this Mac
codespace job [args]          explicitly offload work to a Space worker
codespace menu [args]         install, update, or remove the Space menu app
codespace find <query>        search this Mac, a peer Mac, and Space
codespace t3 scan             discover native sessions using installed T3
codespace t3 import-project ID import native history into an existing T3 project
codespace t3 import ...       import one stopped session (preview bridge required)
codespace sync [status]        publish or inspect nonsecret machine/provider profiles

Aliases for `on` live in ~/.config/codespace/config.json:
  {"hosts":{"mini":"clawdbot@Clawdbots-Mac-mini.local"}}
Local work stays local unless you choose `on` or `job`.""")
        return 0
    if command == "on":
        if not args:
            raise SystemExit("usage: codespace on <host-or-alias> [code args]")
        host, *code_args = args
        alias = host
        host = config().get("hosts", {}).get(host, host)
        if host == alias:
            try:
                for machine in json.loads(CATALOG_CACHE.read_text()):
                    if machine.get("alias") == alias and machine.get("ssh_host"):
                        host = machine["ssh_host"]
                        break
            except (OSError, ValueError):
                pass
        if not isinstance(host, str) or host.startswith("-") or any(c.isspace() for c in host):
            raise SystemExit("codespace: invalid SSH host")
        # SSH command arguments are parsed by the remote shell. Quote the fixed
        # executable and every Code argument, including user prompts.
        import shlex
        remote = " ".join(shlex.quote(x) for x in ["$HOME/.local/bin/codespace", *code_args])
        # Do not quote $HOME itself: it must expand on the remote Mac.
        remote = remote.replace("'$HOME/.local/bin/codespace'", '"$HOME/.local/bin/codespace"', 1)
        remote = 'export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"; ' + remote
        tty = ["-tt"] if sys.stdin.isatty() and sys.stdout.isatty() else ["-T"]
        return subprocess.call(["ssh", *tty, "-o", "ConnectTimeout=8", host, remote])
    if command == "t3":
        return t3(args)
    if command == "sync":
        return sync(args)
    if command in ("space", "job", "menu"):
        sub = args if command == "space" else ["job", *args] if command == "job" else ["menubar", *args]
        return subprocess.call([require("space"), *sub])
    if command == "find":
        if not args:
            raise SystemExit("usage: codespace find <name, path, or description>")
        app = Path("/Applications/Space.app/Contents/Resources/file_transfer.py")
        fallback = Path.home() / "Applications" / "Space.app" / "Contents" / "Resources" / "file_transfer.py"
        helper = app if app.exists() else fallback
        if not helper.exists():
            raise SystemExit("codespace: install the Space menu app first (`codespace menu`)")
        return subprocess.call([sys.executable, str(helper), "search", " ".join(args)])
    # Existing Code commands retain their spelling: `codespace list`,
    # `codespace handoff`, and `codespace <account-id>`.
    return subprocess.call([require("code"), *argv])


if __name__ == "__main__":
    try:
        sys.exit(dispatch(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
