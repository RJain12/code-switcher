def bridge_tunnel_command(peers, port, ssh="/usr/bin/ssh"):
    """launchd restarts this loop, so each pass retries every address (e.g. Tailscale, then LAN)."""
    import shlex
    tunnel = [ssh, "-N", "-T", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8",
              "-o", "StrictHostKeyChecking=yes", "-o", "ExitOnForwardFailure=yes", "-o", "ServerAliveInterval=15",
              "-o", "ServerAliveCountMax=3", "-R", f"127.0.0.1:{port}:127.0.0.1:{port}"]
    loop = 'for host in "$@"; do ' + " ".join(shlex.quote(part) for part in tunnel) + ' "$host"; done'
    return ["/bin/sh", "-c", loop, "codespace-bridge", *peers]


def bridge(args):
    import argparse
    import getpass
    import plistlib
    import re
    import shlex
    parser = argparse.ArgumentParser(prog="codespace bridge")
    parser.add_argument("action", choices=["enable", "disable", "status"])
    parser.add_argument("peer", nargs="?")
    parser.add_argument("--port", type=int, default=42322)
    opts = parser.parse_args(args)
    root = CONFIG.parent / "bridge"
    metadata = root / "connection.json"
    domain = "gui/" + str(os.getuid())
    labels = ["com.codespace.bridge-sshd", "com.codespace.bridge-tunnel"]
    agents = Path.home() / "Library/LaunchAgents"
    def loaded(label):
        return subprocess.run(["launchctl", "print", domain + "/" + label], capture_output=True).returncode == 0
    if opts.action == "status":
        record = json.loads(metadata.read_text()) if metadata.exists() else {}
        print(json.dumps({**record, "services": {label: loaded(label) for label in labels}}, indent=2))
        return 0
    if opts.action == "disable":
        for label in reversed(labels):
            if loaded(label):
                subprocess.run(["launchctl", "bootout", domain + "/" + label], check=True, capture_output=True)
            (agents / (label + ".plist")).unlink(missing_ok=True)
        print("Codespace reverse bridge disabled")
        return 0
    if sys.platform != "darwin" or not opts.peer or not 1024 <= opts.port <= 65535:
        parser.error("enable requires a peer on macOS and a port from 1024 to 65535")
    settings = config()
    alias = settings.get("self_alias") or re.sub(r"[^a-z0-9_-]", "-", socket.gethostname().lower().removesuffix(".local"))[:40]
    if not re.fullmatch(r"[a-z0-9_-]{1,40}", alias):
        parser.error("self_alias must be a short lowercase SSH alias")
    peers = host_candidates(opts.peer, settings)
    peer = reachable_host(opts.peer, settings)
    if not valid_ssh_host(peer):
        parser.error("invalid peer SSH host")
    root.mkdir(parents=True, exist_ok=True, mode=0o700)
    def peer_setup(action, **extra):
        result = subprocess.run(["ssh", "-T", "-o", "BatchMode=yes", "-o", "StrictHostKeyChecking=yes", "-o", "ConnectTimeout=8", peer,
            "python3 -c " + shlex.quote(BRIDGE_PEER_SCRIPT)],
            input=json.dumps({"action": action, "alias": alias, **extra}).encode(),
            capture_output=True, timeout=30)
        if result.returncode:
            raise ValueError("peer bridge setup failed: " + result.stderr.decode(errors="replace").strip())
        return json.loads(result.stdout)
    public = peer_setup("key")["publicKey"]
    host_key = root / "host_ed25519"
    if not host_key.exists():
        subprocess.run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-f", str(host_key)], check=True)
    authorized = root / "authorized_keys"
    authorized.write_text('no-agent-forwarding,no-X11-forwarding ' + public + '\n')
    authorized.chmod(0o600)
    user = getpass.getuser()
    configuration = root / "sshd_config"
    configuration.write_text(f'''Port {opts.port}
ListenAddress 127.0.0.1
HostKey {host_key}
PidFile {root}/sshd.pid
AuthorizedKeysFile {authorized}
AllowUsers {user}
PasswordAuthentication no
KbdInteractiveAuthentication no
AuthenticationMethods publickey
UsePAM no
PermitRootLogin no
AllowAgentForwarding no
AllowTcpForwarding local
PermitOpen 127.0.0.1:3773 localhost:3773
X11Forwarding no
PermitTunnel no
LogLevel ERROR
Subsystem sftp /usr/libexec/sftp-server
''')
    configuration.chmod(0o600)
    subprocess.run(["/usr/sbin/sshd", "-t", "-f", str(configuration)], check=True, capture_output=True)
    peer_setup("configure", port=opts.port, user=user, hostKey=host_key.with_suffix(".pub").read_text())
    commands = [["/usr/sbin/sshd", "-D", "-e", "-f", str(configuration)],
                bridge_tunnel_command([peer, *[p for p in peers if p != peer]], opts.port)]
    agents.mkdir(parents=True, exist_ok=True)
    for label, command in zip(labels, commands):
        if loaded(label):
            subprocess.run(["launchctl", "bootout", domain + "/" + label], check=True, capture_output=True)
        path = agents / (label + ".plist")
        data = {"Label": label, "ProgramArguments": command, "KeepAlive": True, "RunAtLoad": True,
                "ThrottleInterval": 15, "ProcessType": "Background",
                "StandardOutPath": str(root / (label + ".log")), "StandardErrorPath": str(root / (label + ".log"))}
        path.write_bytes(plistlib.dumps(data)); path.chmod(0o600)
        subprocess.run(["launchctl", "enable", domain + "/" + label], check=True, capture_output=True)
        subprocess.run(["launchctl", "bootstrap", domain, str(path)], check=True, capture_output=True)
    record = {"peer": peer, "peers": [peer, *[p for p in peers if p != peer]], "aliasOnPeer": "codespace-" + alias, "port": opts.port, "localBind": "127.0.0.1"}
    private_json_write(metadata, record)
    print(json.dumps(record, indent=2))
    return 0


def dispatch(argv):
    if not argv or argv[0] in ("code", "local"):
        args = argv[1:] if argv else []
        return subprocess.call([require("code"), *args])

    command, *args = argv
    if command in ("-h", "--help", "help"):
        print("""codespace [code args]       start Code locally
codespace on <host> [args]    start Code on a trusted Mac over SSH
codespace bridge enable PEER | disable | status  reconnecting reverse Mac access
codespace space [args]        run the Space CLI on this Mac
codespace job [args]          explicitly offload work to a Space worker
codespace run [options] -- COMMAND  route portable work or keep Mac-dependent work local
codespace menu [args]         install, update, or remove the Space menu app
codespace find <query>        search this Mac, a peer Mac, and Space
codespace t3 start --account ID --model MODEL --prompt TEXT [--cwd PATH]
codespace t3 status|stop THREAD_ID  inspect or stop a dispatched thread
codespace t3 wait THREAD_ID [--timeout SECONDS] wait for completion (nonzero on failure)
codespace t3 connect           enroll renewable local T3 access
codespace t3 renew             renew a managed token when due
codespace t3 providers [--apply] map Code accounts into this host’s T3
codespace t3 scan             discover native sessions using installed T3
codespace t3 import-project ID import native history into an existing T3 project
codespace t3 import-cwd PATH   create/reuse a T3 project and import native CLI history
codespace t3 handoff ACCOUNT SESSION  import one completed Code session (Codespace T3 fork)
codespace t3 auto-import on|off|status  automatic completed-session handoff (Codespace T3 fork)
codespace t3 import ...       import one stopped session (preview bridge required)
codespace sync [status]        publish or inspect nonsecret machine/provider profiles
codespace doctor [--local]     check live T3, peer Mac, and cloud catalog connections
codespace update [--install | --rollback | --status] manage paired CLI releases
codespace auto-update enable|disable|status          hourly macOS updates

Aliases for `on` live in ~/.config/codespace/config.json:
  {"hosts":{"mini":["clawdbot@mini.tailnet.ts.net","clawdbot@Clawdbots-Mac-mini.local"]}}\nThe first address whose SSH port answers is used.
Local work stays local unless you choose `on` or `job`.""")
        return 0
    if command == "bridge":
        return bridge(args)
    if command == "doctor":
        return doctor(args)
    if command == "on":
        if not args:
            raise SystemExit("usage: codespace on <host-or-alias> [code args]")
        alias, *code_args = args
        host = reachable_host(alias)
        if not valid_ssh_host(host):
            raise SystemExit("codespace: invalid SSH host")
        # SSH command arguments are parsed by the remote shell. Quote the fixed
        # executable and every Code argument, including user prompts.
        import shlex
        remote = " ".join(shlex.quote(x) for x in ["$HOME/.local/bin/codespace", *code_args])
        # Do not quote $HOME itself: it must expand on the remote Mac.
        remote = remote.replace("'$HOME/.local/bin/codespace'", '"$HOME/.local/bin/codespace"', 1)
        remote = 'export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"; ' + remote
        tty = ["-tt"] if sys.stdin.isatty() and sys.stdout.isatty() else ["-T"]
        return subprocess.call(["ssh", *tty, "-o", "ConnectTimeout=8", host, remote])
    if command == "run":
        return run_workload(args)
    if command == "maintenance":
        return maintenance()
    if command == "auto-update":
        return auto_update(args)
    if command == "update" and "--providers" not in args:
        return update([] if args == ["--self"] else args)
    if command == "t3":
        return t3(args)
    if command == "sync":
        return sync(args)
    if command in ("space", "job", "menu"):
        sub = args if command == "space" else ["job", *args] if command == "job" else ["menubar", *args]
        return subprocess.call([require("space"), *sub])
    if command == "find":
        if not args:
            raise SystemExit("usage: codespace find <name, path, or description>")
        app = Path("/Applications/Space.app/Contents/Resources/file_transfer.py")
        fallback = Path.home() / "Applications" / "Space.app" / "Contents" / "Resources" / "file_transfer.py"
        helper = app if app.exists() else fallback
        if not helper.exists():
            raise SystemExit("codespace: install the Space menu app first (`codespace menu`)")
        return subprocess.call([sys.executable, str(helper), "search", " ".join(args)])
    # Existing Code commands retain their spelling: `codespace list`,
    # `codespace handoff`, and `codespace <account-id>`.
    return subprocess.call([require("code"), *argv])


if __name__ == "__main__":
    try:
        sys.exit(dispatch(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
