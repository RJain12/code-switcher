#!/usr/bin/env python3
"""One local-first entry point for Code, Space, and trusted Macs."""
import json
import os
from pathlib import Path
import shutil
import socket
import subprocess
import sys
import tempfile
import time

CONFIG = Path.home() / ".config" / "codespace" / "config.json"
CATALOG = Path.home() / "Space" / ".codespace" / "machines"
CATALOG_CACHE = Path.home() / ".config" / "codespace" / "machines.json"


RELEASE_ROOT = Path.home() / ".local" / "share" / "codespace"
INSTALL_BIN = Path.home() / ".local" / "bin"


def atomic_link(target, link):
    temporary = link.with_name(link.name + ".new-" + str(os.getpid()))
    try:
        temporary.symlink_to(target)
        temporary.replace(link)
    finally:
        temporary.unlink(missing_ok=True)


def release_fetch(url, limit=2 * 1024 * 1024):
    import urllib.request
    request = urllib.request.Request(url, headers={"User-Agent": "Codespace-updater"})
    with urllib.request.urlopen(request, timeout=30) as response:
        data = response.read(limit + 1)
    if len(data) > limit:
        raise ValueError("release response exceeds size limit")
    return data


def validate_release(directory):
    import hashlib
    manifest = json.loads((directory / "release.json").read_text())
    for name in ("code", "codespace"):
        data = (directory / name).read_bytes()
        if hashlib.sha256(data).hexdigest() != manifest["sha256"][name]:
            raise ValueError("cached release failed integrity check: " + name)
        compile(data, str(directory / name), "exec")
    return manifest["commit"]


def update(args):
    """Install both entry points from one immutable GitHub commit."""
    import fcntl
    import hashlib
    import re
    if args not in ([], ["--install"], ["--rollback"], ["--status"]):
        raise SystemExit("usage: codespace update [--install | --rollback | --status]")
    current, previous = RELEASE_ROOT / "current", RELEASE_ROOT / "previous"
    if args == ["--status"]:
        print(json.dumps({"current": current.resolve().name if current.is_symlink() else None,
                          "previous": previous.resolve().name if previous.is_symlink() else None}, indent=2))
        return 0
    if not current.is_symlink() and args != ["--install"]:
        raise SystemExit("codespace: enable the managed installation with `codespace update --install`")
    RELEASE_ROOT.mkdir(parents=True, exist_ok=True, mode=0o700)
    with (RELEASE_ROOT / "update.lock").open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise SystemExit("codespace: an update is already running") from None
        if args == ["--rollback"]:
            if not previous.is_symlink():
                raise SystemExit("codespace: no previous managed release")
            target = previous.resolve()
            validate_release(target)
        else:
            result = json.loads(release_fetch("https://api.github.com/repos/RJain12/code-switcher/commits/main"))
            commit = result["sha"]
            if not isinstance(commit, str) or not re.fullmatch(r"[a-f0-9]{40}", commit):
                raise ValueError("GitHub returned an invalid commit")
            target = RELEASE_ROOT / "releases" / commit
            target.parent.mkdir(parents=True, exist_ok=True)
            if not target.exists():
                stage = Path(tempfile.mkdtemp(prefix=".stage-", dir=target.parent))
                try:
                    hashes = {}
                    for name in ("code", "codespace"):
                        data = release_fetch(f"https://raw.githubusercontent.com/RJain12/code-switcher/{commit}/{name}")
                        compile(data, name, "exec")
                        (stage / name).write_bytes(data)
                        (stage / name).chmod(0o755)
                        hashes[name] = hashlib.sha256(data).hexdigest()
                    (stage / "release.json").write_text(json.dumps({"commit": commit, "sha256": hashes}))
                    validate_release(stage)
                    # These commands exercise both entry points without touching accounts.
                    for name, flag in (("code", "--version"), ("codespace", "--help")):
                        subprocess.run([sys.executable, str(stage / name), flag], check=True,
                                       stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, timeout=15)
                    stage.rename(target)
                finally:
                    if stage.exists():
                        shutil.rmtree(stage)
            validate_release(target)
        target = target.resolve()
        unchanged = current.is_symlink() and current.resolve() == target
        INSTALL_BIN.mkdir(parents=True, exist_ok=True)
        # Preserve initial entry points, including links to a development checkout.
        backups = RELEASE_ROOT / "original-entrypoints"
        backups.mkdir(exist_ok=True)
        for name in ("code", "Code", "codespace"):
            entry = INSTALL_BIN / name
            backup = backups / name
            if (entry.exists() or entry.is_symlink()) and not (backup.exists() or backup.is_symlink()):
                shutil.copy2(entry, backup, follow_symlinks=False)
        old = current.resolve() if current.is_symlink() else None
        if old and old != target:
            atomic_link(old, previous)
        atomic_link(target, current)
        for name in ("code", "Code", "codespace"):
            atomic_link(current / ("code" if name == "Code" else name), INSTALL_BIN / name)
        print(("Codespace is current: " if unchanged else "Codespace installed: ") + target.name[:12])
        return 0


def auto_update(args):
    import plistlib
    if args not in (["enable"], ["disable"], ["status"]):
        raise SystemExit("usage: codespace auto-update enable|disable|status")
    if sys.platform != "darwin":
        raise SystemExit("codespace: automatic updates currently use macOS launchd")
    label = "com.codespace.cli-update"
    domain = "gui/" + str(os.getuid())
    service = domain + "/" + label
    plist = Path.home() / "Library" / "LaunchAgents" / (label + ".plist")
    loaded = subprocess.run(["launchctl", "print", service], capture_output=True).returncode == 0
    if args == ["status"]:
        print(json.dumps({"configured": plist.exists(), "loaded": loaded,
                          "interval_seconds": 3600, "log": str(RELEASE_ROOT / "update.log")}, indent=2))
        return 0
    if loaded:
        subprocess.run(["launchctl", "bootout", service], check=True, capture_output=True)
    if args == ["disable"]:
        plist.unlink(missing_ok=True)
        print("Codespace automatic updates disabled")
        return 0
    current = RELEASE_ROOT / "current"
    if not current.is_symlink():
        raise SystemExit("codespace: run `codespace update --install` first")
    validate_release(current)
    plist.parent.mkdir(parents=True, exist_ok=True)
    document = {"Label": label, "ProgramArguments": [sys.executable, str(current / "codespace"), "maintenance"],
                "StartInterval": 3600, "RunAtLoad": True,
                "ProcessType": "Background", "LowPriorityIO": True,
                "StandardOutPath": str(RELEASE_ROOT / "update.log"),
                "StandardErrorPath": str(RELEASE_ROOT / "update-error.log"),
                "EnvironmentVariables": {"PATH": str(INSTALL_BIN) + ":/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"}}
    temporary = plist.with_suffix(".tmp")
    temporary.write_bytes(plistlib.dumps(document))
    temporary.chmod(0o600)
    temporary.replace(plist)
    subprocess.run(["launchctl", "enable", service], check=True, capture_output=True)
    subprocess.run(["launchctl", "bootstrap", domain, str(plist)], check=True, capture_output=True)
    print("Codespace automatic updates enabled (hourly and at login)")
    return 0


def config():
    try:
        data = json.loads(CONFIG.read_text())
        if isinstance(data, dict):
            return data
    except (OSError, ValueError):
        pass
    return {}


def require(name):
    sibling = Path(__file__).resolve().parent / name
    binary = str(sibling) if name == "code" and sibling.is_file() and os.access(sibling, os.X_OK) else shutil.which(name)
    if not binary:
        raise SystemExit(f"codespace: {name} is not installed on this Mac")
    return binary


def valid_ssh_host(host):
    return isinstance(host, str) and bool(host) and not host.startswith("-") and not any(c.isspace() for c in host)


def host_candidates(alias, settings=None):
    """SSH targets for an alias, in preference order: config entries, then the synced catalog."""
    settings = config() if settings is None else settings
    configured = settings.get("hosts", {}).get(alias)
    candidates = configured if isinstance(configured, list) else [configured] if configured else []
    try:
        for machine in json.loads(CATALOG_CACHE.read_text()):
            if machine.get("alias") == alias:
                candidates += machine.get("ssh_hosts") or [machine.get("ssh_host")]
    except (OSError, ValueError, TypeError, AttributeError):
        pass
    unique = []
    for host in candidates:
        if valid_ssh_host(host) and host not in unique:
            unique.append(host)
    if unique or configured:
        return unique
    return [alias] if valid_ssh_host(alias) else []


def self_ssh_hosts():
    """Addresses peers can use to reach this Mac: Tailscale first (works off-LAN), then Bonjour."""
    import getpass
    user = getpass.getuser()
    hosts = []
    for binary in (shutil.which("tailscale"), "/Applications/Tailscale.app/Contents/MacOS/Tailscale"):
        if binary and Path(binary).exists():
            try:
                status = json.loads(subprocess.run([binary, "status", "--json"], capture_output=True,
                                                   text=True, timeout=5).stdout)
                name = status.get("Self", {}).get("DNSName", "").rstrip(".")
                if name:
                    hosts.append(f"{user}@{name}")
            except (OSError, ValueError, subprocess.TimeoutExpired, AttributeError):
                pass
            break
    try:
        local = subprocess.run(["scutil", "--get", "LocalHostName"], capture_output=True, text=True, timeout=5).stdout.strip()
        if local:
            hosts.append(f"{user}@{local}.local")
    except (OSError, subprocess.TimeoutExpired):
        pass
    return hosts


def reachable_host(alias, settings=None, timeout=3):
    """First candidate whose SSH port answers; name resolution for `.local` can fail while Tailscale works."""
    candidates = host_candidates(alias, settings)
    for host in candidates:
        hostname = host.rsplit("@", 1)[-1]
        try:
            socket.create_connection((hostname, 22), timeout=timeout).close()
            return host
        except OSError:
            continue
    return candidates[0] if candidates else None


def connection_report(local_only=False):
    """Probe configured connections without starting agents, renewing, or publishing."""
    import concurrent.futures
    import datetime
    import urllib.error
    import urllib.parse
    settings = config()

    def local_t3():
        base = settings.get("t3_url", "http://127.0.0.1:3773")
        url = urllib.parse.urlsplit(base)
        if (url.scheme not in ("http", "https") or not url.hostname or url.username or url.password
                or url.query or url.fragment or url.path not in ("", "/")
                or (url.scheme == "http" and url.hostname not in ("127.0.0.1", "localhost", "::1"))):
            return {"status": "invalid-config"}
        token = os.environ.get("CODESPACE_T3_TOKEN")
        if not token:
            try:
                token, _ = read_t3_token(Path(settings.get("t3_token_file", str(CONFIG.parent / "t3-token"))).expanduser())
            except FileNotFoundError:
                return {"status": "not-configured"}
        try:
            verify_t3_token(base, token)
            return {"status": "authenticated"}
        except urllib.error.HTTPError as error:
            return {"status": "rejected" if error.code in (401, 403) else "unavailable", "httpStatus": error.code}

    def peer(alias):
        host = reachable_host(alias, settings)
        if not valid_ssh_host(host):
            return {"status": "invalid-config"}
        command = 'export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"; "$HOME/.local/bin/codespace" doctor --local'
        result = subprocess.run(["ssh", "-T", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8",
                                 "-o", "StrictHostKeyChecking=yes", host, command],
                                capture_output=True, text=True, timeout=25)
        try:
            report = json.loads(result.stdout)
            if report.get("version") != 1 or not isinstance(report.get("checks"), dict):
                raise ValueError("unsupported health response")
            return {"status": "reachable", "machine": report["machine"], "via": host,
                    "t3": report["checks"]["t3"], "release": report.get("release")}
        except (ValueError, KeyError, TypeError, AttributeError):
            return {"status": "unavailable", "detail": "SSH or the remote Codespace health command failed"}

    def cloud_catalog():
        uri = settings.get("sync_uri")
        if not uri:
            return {"status": "not-configured"}
        if not isinstance(uri, str) or not uri.startswith("gs://") or any(c.isspace() for c in uri):
            return {"status": "invalid-config"}
        environment = dict(os.environ)
        if Path("/opt/homebrew/bin/python3").exists():
            environment.setdefault("CLOUDSDK_PYTHON", "/opt/homebrew/bin/python3")
        result = subprocess.run([require("gcloud"), "storage", "ls", uri.rstrip("/") + "/"],
                                capture_output=True, text=True, timeout=25, env=environment)
        return {"status": "accessible" if result.returncode == 0 else "unavailable"}

    def checked(action):
        started = time.monotonic()
        try:
            result = action()
        except (Exception, SystemExit) as error:
            # Command output and exception messages can contain credentials or URLs.
            result = {"status": "unavailable", "errorType": type(error).__name__}
        return {**result, "durationMs": round((time.monotonic() - started) * 1000)}

    actions = {"t3": local_t3}
    if not local_only:
        actions["cloudCatalog"] = cloud_catalog
        for alias in settings.get("hosts", {}):
            actions["peer:" + alias] = lambda alias=alias: peer(alias)
    with concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:
        futures = {name: pool.submit(checked, action) for name, action in actions.items()}
        checks = {name: future.result() for name, future in futures.items()}
    current = RELEASE_ROOT / "current"
    return {"version": 1, "machine": socket.gethostname(),
            "checkedAt": datetime.datetime.now(datetime.timezone.utc).isoformat(),
            "release": current.resolve().name if current.is_symlink() else None,
            "checks": checks,
            "scope": "Connection reachability and T3 authentication; provider login and quota are not tested"}


def doctor(args):
    if args not in ([], ["--local"]):
        raise SystemExit("usage: codespace doctor [--local]")
    report = connection_report(local_only=args == ["--local"])
    print(json.dumps(report, indent=2))
    failures = ("unavailable", "rejected", "invalid-config")
    return int(any(check["status"] in failures or check.get("t3", {}).get("status") in failures
                   for check in report["checks"].values()))


def sync(args, quiet=False):
    if args not in ([], ["status"]):
        raise SystemExit("usage: codespace sync [status]")
    uri = config().get("sync_uri")
    if uri and (not isinstance(uri, str) or not uri.startswith("gs://") or any(c.isspace() for c in uri)):
        raise SystemExit("codespace: sync_uri must be a gs:// path")
    if not uri and not os.path.ismount(CATALOG.parents[1]):
        raise SystemExit("codespace: mount Space before syncing (`space mount`)")
    gcloud = shutil.which("gcloud") or "/opt/homebrew/bin/gcloud"
    cloud_python = "/opt/homebrew/bin/python3" if Path("/opt/homebrew/bin/python3").exists() else (
        shutil.which("python3") or sys.executable
    )
    cloud_env = dict(os.environ, CLOUDSDK_PYTHON=cloud_python)
    if not args:
        settings = config()
        host = socket.gethostname()
        accounts_path = Path.home() / ".code-accounts" / "accounts.json"
        try:
            accounts = json.loads(accounts_path.read_text()).get("accounts", [])
        except (OSError, ValueError):
            accounts = []
        profiles = [{key: account[key] for key in ("id", "provider", "name") if key in account}
                    for account in accounts]
        t3_id_path = Path.home() / ".t3" / "userdata" / "environment-id"
        try:
            t3_id = t3_id_path.read_text().strip()[:200]
        except OSError:
            t3_id = None
        ssh_hosts = [h for h in [settings.get("ssh_host"), *self_ssh_hosts()] if valid_ssh_host(h)]
        ssh_hosts = list(dict.fromkeys(ssh_hosts))
        record = {"version": 1, "machine": host, "alias": settings.get("self_alias"),
                  "ssh_host": ssh_hosts[0] if ssh_hosts else None, "ssh_hosts": ssh_hosts, "profiles": profiles,
                  "t3_environment_id": t3_id, "space": bool(shutil.which("space")),
                  "updated_at": time.time()}
        if uri:
            with tempfile.NamedTemporaryFile(mode="w", suffix=".json", delete=False) as output:
                json.dump(record, output, indent=2)
                temporary = output.name
            try:
                subprocess.run([gcloud, "storage", "cp", temporary,
                                uri.rstrip("/") + "/" + host + ".json", "-q"],
                               check=True, timeout=45, env=cloud_env, capture_output=True, text=True)
            finally:
                Path(temporary).unlink(missing_ok=True)
        else:
            CATALOG.mkdir(parents=True, exist_ok=True)
            target = CATALOG / (host + ".json")
            temporary = target.with_suffix(".tmp")
            temporary.write_text(json.dumps(record, indent=2) + "\n")
            temporary.replace(target)
    machines = []
    if uri:
        listed = subprocess.run([gcloud, "storage", "ls", uri.rstrip("/") + "/"],
                                capture_output=True, text=True, timeout=30, env=cloud_env)
        if listed.returncode:
            raise ValueError("machine catalog listing failed; cached machines were preserved")
        paths = [line for line in listed.stdout.splitlines() if line.endswith(".json")]
    else:
        paths = list(CATALOG.glob("*.json")) if CATALOG.exists() else []
    for path in paths:
        try:
            if uri:
                content = subprocess.run([gcloud, "storage", "cat", str(path)],
                                         capture_output=True, text=True, check=True, timeout=30,
                                         env=cloud_env).stdout
            else:
                content = path.read_text()
            record = json.loads(content)
            if not isinstance(record, dict) or record.get("version") != 1 or not isinstance(record.get("machine"), str):
                raise ValueError("invalid machine record")
            machines.append(record)
        except (OSError, ValueError, subprocess.SubprocessError) as error:
            raise ValueError("machine catalog read failed; cached machines were preserved") from error
    machines.sort(key=lambda item: item.get("alias") or item.get("machine") or "")
    private_json_write(CATALOG_CACHE, machines)
    if not quiet:
        print(json.dumps(machines, indent=2))
    return 0


T3_RPC_SCRIPT = r"""
const chunks = [];
for await (const chunk of process.stdin) chunks.push(chunk);
const input = JSON.parse(Buffer.concat(chunks).toString());
let ws;
const timer = setTimeout(() => fail("T3 RPC timed out while the host was processing the request"), input.timeoutSeconds * 1000);
function fail(message) {
  clearTimeout(timer);
  if (ws) ws.close();
  process.stderr.write(message + "\n");
  process.exit(1);
}
try {
  if (typeof WebSocket !== "function") fail("T3 native RPC requires Node 22 or newer");
  const response = await fetch(input.base + "/api/auth/websocket-ticket", {
    method: "POST", headers: {Authorization: "Bearer " + input.token},
    redirect: "manual", signal: AbortSignal.timeout(15000),
  });
  if (!response.ok) fail("T3 ticket request failed (HTTP " + response.status + ")");
  const ticket = (await response.json()).ticket;
  if (typeof ticket !== "string" || !ticket) fail("T3 returned an invalid WebSocket ticket");
  const url = new URL(input.base + "/ws");
  url.protocol = url.protocol === "https:" ? "wss:" : "ws:";
  url.searchParams.set("wsTicket", ticket);
  ws = new WebSocket(url);
  let finished = false;
  ws.addEventListener("open", () => ws.send(JSON.stringify({
    _tag: "Request", id: "1", tag: input.method, payload: input.payload, headers: [],
  })));
  ws.addEventListener("error", () => fail("T3 WebSocket connection failed"));
  ws.addEventListener("close", () => { if (!finished) fail("T3 closed the connection before replying"); });
  ws.addEventListener("message", event => {
    try {
      if (typeof event.data !== "string" || event.data.length > 32 * 1024 * 1024) fail("Invalid or oversized T3 response");
      const decoded = JSON.parse(event.data);
      for (const message of Array.isArray(decoded) ? decoded : [decoded]) {
        if (message._tag === "Ping") { ws.send(JSON.stringify({_tag: "Pong"})); continue; }
        if (message._tag === "Defect" || message._tag === "ClientProtocolError") fail("T3 rejected the RPC protocol");
        if (message._tag !== "Exit" || String(message.requestId) !== "1") continue;
        if (message.exit?._tag !== "Success") fail("T3 RPC failed: " + JSON.stringify(message.exit?.cause ?? []));
        finished = true;
        clearTimeout(timer);
        process.stdout.write(JSON.stringify(message.exit.value) + "\n");
        ws.close();
      }
    } catch { fail("Could not decode the T3 RPC response"); }
  });
} catch { fail("Could not connect to T3"); }
"""


def t3_provider_plan(accounts, settings, home=None):
    """Map local native accounts without copying tokens or changing existing instances."""
    import re
    home = Path(home or Path.home())
    instances = settings.get("providerInstances", {})
    legacy = settings.get("providers", {})
    candidates = dict(instances)
    for driver in ("codex", "claudeAgent"):
        if driver not in candidates:
            candidates[driver] = {"driver": driver, "config": legacy.get(driver, {})}
    additions, mappings, skipped = {}, [], []
    def canonical(value):
        return os.path.normpath(os.path.expanduser(value))
    for account in accounts:
        provider = account.get("provider")
        if provider not in ("codex", "claude"):
            skipped.append({"account": account.get("id"), "reason": "provider needs a separate credential adapter"})
            continue
        driver = "codex" if provider == "codex" else "claudeAgent"
        source_home = canonical(account.get("home") or str(home / (".codex" if provider == "codex" else ".claude")))
        if not os.path.isabs(source_home):
            raise ValueError("Code account homes must be absolute paths")
        match = None
        for key, entry in {**candidates, **additions}.items():
            if entry.get("driver") != driver:
                continue
            cfg = entry.get("config") or {}
            if not isinstance(cfg, dict):
                continue
            # A shadow home may use different credentials from its shared history.
            location = cfg.get("shadowHomePath") or cfg.get("homePath") or str(home / (".codex" if provider == "codex" else ".claude"))
            if canonical(location) == source_home:
                match = key
                break
        if match is None:
            match = "codespace-" + re.sub(r"[^a-z0-9_-]+", "-", str(account["id"]).lower()).strip("-")
            if match in candidates or match in additions:
                raise ValueError("T3 instance name collision for " + account["id"])
            additions[match] = {"driver": driver, "displayName": "Code · " + (account.get("name") or account["id"]),
                                "enabled": True, "config": {"homePath": source_home, "enabled": True}}
        mappings.append({"account": account["id"], "instance": match, "home": source_home, "new": match in additions})
    return {"additions": additions, "mappings": mappings, "skipped": skipped}


def read_t3_token(path):
    info = path.stat()
    if info.st_mode & 0o077 or info.st_uid != os.getuid():
        raise ValueError("T3 token file must be owned by you and private (chmod 600)")
    raw = path.read_text().strip()
    if raw.startswith("{"):
        data = json.loads(raw)
        if data.get("version") != 1 or data.get("managedBy") != "codespace":
            raise ValueError("unsupported T3 connection file")
        return data["token"], data
    return raw, None


def private_json_write(path, value):
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd, temporary = tempfile.mkstemp(prefix=".connection-", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as output:
            json.dump(value, output)
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, path)
    finally:
        Path(temporary).unlink(missing_ok=True)


def verify_t3_token(base, token):
    import urllib.request
    class NoRedirect(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, *args, **kwargs):
            return None
    request = urllib.request.Request(base.rstrip("/") + "/api/auth/session", headers={"Authorization": "Bearer " + token})
    with urllib.request.build_opener(NoRedirect).open(request, timeout=10) as response:
        state = json.load(response)
    if state.get("authenticated") is not True:
        raise ValueError("T3 did not authenticate the new connection")


def renew_t3_connection(if_needed=False):
    import datetime
    import fcntl
    import plistlib
    import urllib.parse
    settings = config()
    path = Path(settings.get("t3_token_file", str(CONFIG.parent / "t3-token"))).expanduser()
    if os.environ.get("CODESPACE_T3_TOKEN"):
        if if_needed:
            return {"status": "external-token"}
        raise ValueError("unset CODESPACE_T3_TOKEN before enrolling a managed connection")
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    with path.with_suffix(".renew-lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        old_token, old = read_t3_token(path) if path.exists() else (None, None)
        now = datetime.datetime.now(datetime.timezone.utc)
        expires = datetime.datetime.fromisoformat(old["expiresAt"].replace("Z", "+00:00")) if old else None
        if if_needed and not old:
            return {"status": "unmanaged"}
        if if_needed and expires > now + datetime.timedelta(days=7):
            return {"status": "current", "expiresAt": old["expiresAt"]}
        base = settings.get("t3_url", "http://127.0.0.1:3773")
        url = urllib.parse.urlsplit(base)
        if (url.scheme != "http" or url.hostname not in ("127.0.0.1", "localhost", "::1")
                or url.username or url.password or url.query or url.fragment or url.path not in ("", "/")):
            raise ValueError("managed renewal must run on the T3 host using its loopback HTTP URL")
        data_dir = Path(settings.get("t3_base_dir", str(Path.home() / ".t3"))).expanduser().resolve()
        runtime = json.loads((data_dir / "userdata" / "server-runtime.json").read_text())
        if runtime.get("port") != (url.port or 80):
            raise ValueError("T3 URL does not match this host's runtime port")
        if old and (old.get("baseDir") != str(data_dir) or old.get("baseUrl") != base.rstrip("/")):
            raise ValueError("managed T3 connection belongs to a different host or data directory")
        if if_needed and expires > now:
            # Do not silently undo an intentional server-side revocation.
            verify_t3_token(base, old_token)
        app = Path(settings.get("t3_app", "/Applications/T3 Code (Alpha).app"))
        with (app / "Contents" / "Info.plist").open("rb") as source:
            executable = plistlib.load(source)["CFBundleExecutable"]
        binary = app / "Contents" / "MacOS" / executable
        entry = app / "Contents" / "Resources" / "app.asar" / "apps" / "server" / "dist" / "bin.mjs"
        command = [str(binary), str(entry), "auth", "session"]
        environment = dict(os.environ, ELECTRON_RUN_AS_NODE="1")
        issued = subprocess.run([*command, "issue", "--base-dir", str(data_dir), "--ttl", "30d",
                                 "--label", "Codespace managed CLI connection", "--json"],
                                env=environment, capture_output=True, text=True, timeout=30)
        if issued.returncode:
            raise ValueError("the installed T3 CLI could not issue a connection token")
        record = json.loads(issued.stdout)
        token = record.get("token")
        expiry = datetime.datetime.fromisoformat(record["expiresAt"].replace("Z", "+00:00"))
        if not isinstance(token, str) or not token or any(c.isspace() for c in token) or expiry <= now:
            raise ValueError("T3 returned an invalid connection token or expiry")
        verify_t3_token(base, token)
        private_json_write(path, {"version": 1, "managedBy": "codespace", "token": token,
                                 "sessionId": record["sessionId"], "expiresAt": record["expiresAt"],
                                 "baseDir": str(data_dir), "baseUrl": base.rstrip("/")})
        cleanup = "none"
        if old and old.get("sessionId") and old["sessionId"] != record["sessionId"]:
            revoked = subprocess.run([*command, "revoke", old["sessionId"], "--base-dir", str(data_dir)],
                                     env=environment, capture_output=True, timeout=30)
            cleanup = "revoked" if revoked.returncode == 0 else "pending"
        return {"status": "renewed", "expiresAt": record["expiresAt"], "previousSession": cleanup}


def maintenance():
    results = {}
    def refresh_catalog():
        if not config().get("sync_uri"):
            return {"status": "not-configured"}
        sync([], quiet=True)
        return {"status": "synchronized"}
    def refresh_providers():
        if config().get("t3_auto_providers") is not True:
            return {"status": "not-configured"}
        return t3(["providers", "--apply"], quiet=True)
    def refresh_threads():
        if config().get("t3_auto_import") is not True:
            return {"status": "not-configured"}
        result = subprocess.run([sys.executable, require("code"), "thread-sync", "--auto"],
                                capture_output=True, text=True, timeout=950, check=True)
        return json.loads(result.stdout)
    def keep_logins_fresh():
        if config().get("keep_fresh") is False:
            return {"status": "disabled"}
        result = subprocess.run([sys.executable, require("code"), "keep-fresh"],
                                capture_output=True, text=True, timeout=900)
        return json.loads(result.stdout)
    for name, action in (("t3", lambda: renew_t3_connection(if_needed=True)),
                         ("logins", keep_logins_fresh),
                         ("providers", refresh_providers), ("threads", refresh_threads), ("sync", refresh_catalog),
                         ("update", lambda: update([]))):
        try:
            results[name] = {"ok": True, "result": action()}
        except (Exception, SystemExit) as error:
            results[name] = {"ok": False, "error": str(error)}
    print(json.dumps(results, indent=2))
    return 0 if all(result["ok"] for result in results.values()) else 1


def t3_http(base, token, path, payload=None):
    import urllib.request
    class NoRedirect(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, *args, **kwargs):
            return None
    request = urllib.request.Request(base.rstrip("/") + path,
        data=json.dumps(payload).encode() if payload is not None else None,
        headers={"Authorization": "Bearer " + token, "Content-Type": "application/json"})
    with urllib.request.build_opener(NoRedirect).open(request, timeout=60) as response:
        data = response.read(32 * 1024 * 1024 + 1)
    if len(data) > 32 * 1024 * 1024:
        raise ValueError("T3 response exceeds the 32 MiB limit")
    return json.loads(data)


def t3_rpc_value(base, token, method, payload):
    result = subprocess.run([require("node"), "--input-type=module", "-e", T3_RPC_SCRIPT],
        input=json.dumps({"base": base.rstrip("/"), "token": token, "method": method,
                          "payload": payload, "timeoutSeconds": 60}).encode(),
        capture_output=True, timeout=65)
    if result.returncode:
        raise ValueError("T3 RPC failed: " + result.stderr.decode(errors="replace").strip())
    return json.loads(result.stdout)


def t3_start(args, base, token):
    import argparse
    import datetime
    import fcntl
    import hashlib
    import uuid
    parser = argparse.ArgumentParser(prog="codespace t3 start")
    parser.add_argument("--account", required=True)
    parser.add_argument("--model", required=True)
    parser.add_argument("--cwd", default=os.getcwd())
    parser.add_argument("--title", default="Code task")
    parser.add_argument("--request-id", default=None, help="reuse this ID to safely retry an interrupted dispatch")
    parser.add_argument("--prompt", required=True, help="task text, or - to read stdin")
    opts = parser.parse_args(args)
    prompt = sys.stdin.read() if opts.prompt == "-" else opts.prompt
    if not prompt.strip() or not opts.title.strip() or not opts.model.strip():
        parser.error("prompt, title, and model must not be empty")
    cwd = str(Path(opts.cwd).expanduser().resolve())
    if not Path(cwd).is_dir():
        parser.error("workspace must exist on the execution host")
    request_id = opts.request_id or str(uuid.uuid4())
    identity = hashlib.sha256((base + "\0" + request_id).encode()).hexdigest()[:32]
    directory = CONFIG.parent / "dispatches"
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    record_path = directory / (identity + ".json")
    inputs = {"account": opts.account, "model": opts.model, "cwd": cwd, "title": opts.title, "prompt": prompt}
    with (directory / (identity + ".lock")).open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if record_path.exists():
            record = json.loads(record_path.read_text())
            if record["inputs"] != inputs:
                parser.error("this request ID already belongs to a different task")
        else:
            accounts_path = Path(os.environ.get("CODE_ACCOUNTS_DIR", str(Path.home() / ".code-accounts"))) / "accounts.json"
            accounts = json.loads(accounts_path.read_text())["accounts"]
            account = next((a for a in accounts if a["id"] == opts.account), None)
            if not account:
                parser.error("unknown Code account")
            settings = t3_rpc_value(base, token, "server.getSettings", {})
            plan = t3_provider_plan([account], settings)
            if not plan["mappings"] or plan["additions"]:
                parser.error("configure this account with `codespace t3 providers --apply` first")
            instance_id = plan["mappings"][0]["instance"]
            instance = settings.get("providerInstances", {}).get(instance_id)
            cfg = (instance or {}).get("config") or settings.get("providers", {}).get(instance_id, {})
            if (instance or {}).get("enabled", cfg.get("enabled", True)) is False:
                parser.error("the selected T3 provider instance is disabled")
            snapshot = t3_http(base, token, "/api/orchestration/shell")
            project = next((p for p in snapshot["projects"] if os.path.realpath(p["workspaceRoot"]) == cwd), None)
            project_id = project["id"] if project else "codespace-" + hashlib.sha256(cwd.encode()).hexdigest()[:32]
            thread_id = "codespace-" + identity
            created_at = datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")
            selection = {"instanceId": instance_id, "model": opts.model}
            commands = []
            if not project:
                commands.append({"type": "project.create", "commandId": "codespace-project-" + project_id,
                                 "projectId": project_id, "title": Path(cwd).name or cwd,
                                 "workspaceRoot": cwd, "createdAt": created_at})
            commands.append({"type": "thread.create", "commandId": identity + "-create", "threadId": thread_id,
                             "projectId": project_id, "title": opts.title, "modelSelection": selection,
                             "runtimeMode": "approval-required", "interactionMode": "default",
                             "branch": None, "worktreePath": None, "createdAt": created_at})
            commands.append({"type": "thread.turn.start", "commandId": identity + "-start", "threadId": thread_id,
                             "message": {"messageId": identity + "-prompt", "role": "user", "text": prompt, "attachments": []},
                             "modelSelection": selection, "runtimeMode": "approval-required",
                             "interactionMode": "default", "createdAt": created_at})
            record = {"requestId": request_id, "inputs": inputs, "commands": commands,
                      "threadId": thread_id, "projectId": project_id, "providerInstanceId": instance_id}
            private_json_write(record_path, record)
        print("Codespace dispatch request: " + request_id, file=sys.stderr)
        for command in record["commands"]:
            t3_http(base, token, "/api/orchestration/dispatch", command)
        print(json.dumps({key: record[key] for key in ("requestId", "threadId", "projectId", "providerInstanceId")}, indent=2))
    return 0


def t3_wait(args, base, token):
    import argparse
    import urllib.parse
    parser = argparse.ArgumentParser(prog="codespace t3 wait")
    parser.add_argument("thread")
    parser.add_argument("--timeout", type=float, default=300)
    opts = parser.parse_args(args)
    if not 0 < opts.timeout <= 86400:
        parser.error("timeout must be greater than zero and at most 86400 seconds")
    deadline = time.monotonic() + opts.timeout
    path = "/api/orchestration/threads/" + urllib.parse.quote(opts.thread, safe="")
    while True:
        snapshot = t3_http(base, token, path)
        thread = snapshot["thread"]
        turn = thread.get("latestTurn") or {}
        state = turn.get("state")
        if state in ("completed", "error", "interrupted"):
            print(json.dumps(snapshot, indent=2))
            return 0 if state == "completed" else 1
        if time.monotonic() >= deadline:
            print(json.dumps(snapshot, indent=2))
            print("Codespace wait timed out; the remote task was not stopped", file=sys.stderr)
            return 124
        time.sleep(min(2, max(0, deadline - time.monotonic())))


def shared_t3_history(settings):
    instances = dict(settings.get("providerInstances", {}))
    for driver in ("codex", "claudeAgent"):
        instances.setdefault(driver, {"driver": driver, "config": settings.get("providers", {}).get(driver, {})})
    seen, conflicts = {}, []
    for name, instance in instances.items():
        driver = instance.get("driver")
        if driver not in ("codex", "claudeAgent") or instance.get("enabled") is False:
            continue
        cfg = instance.get("config") or {}
        if cfg.get("enabled") is False:
            continue
        default = ".codex" if driver == "codex" else ".claude"
        home = Path(cfg.get("homePath") or str(Path.home() / default)).expanduser()
        history = home / ("sessions" if driver == "codex" else "projects")
        if not history.exists():
            continue
        identity = (driver, os.path.realpath(history))
        if identity in seen:
            conflicts.append([seen[identity], name])
        else:
            seen[identity] = name
    return conflicts


def t3_import_cwd(path, base, token, selection=None):
    import hashlib
    import datetime
    cwd = str(Path(path).expanduser().resolve())
    if not Path(cwd).is_dir():
        raise ValueError("workspace must exist on the execution host")
    conflicts = [] if selection else shared_t3_history(t3_rpc_value(base, token, "server.getSettings", {}))
    if conflicts:
        raise ValueError("T3 provider instances share transcript directories: " +
                         "; ".join(" / ".join(pair) for pair in conflicts) +
                         ". Workspace import would duplicate account history; use direct T3 dispatch until history can be filtered by account.")
    snapshot = t3_http(base, token, "/api/orchestration/shell")
    project = next((p for p in snapshot["projects"] if os.path.realpath(p["workspaceRoot"]) == cwd), None)
    project_id = project["id"] if project else "codespace-" + hashlib.sha256(cwd.encode()).hexdigest()[:32]
    if not project:
        t3_http(base, token, "/api/orchestration/dispatch", {
            "type": "project.create", "commandId": "codespace-project-" + project_id,
            "projectId": project_id, "title": Path(cwd).name or cwd, "workspaceRoot": cwd,
            "createdAt": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")})
    result = t3_rpc_value(base, token, "agentSessions.importSelected" if selection else "agentSessions.import", {
        "projectId": project_id, "expectedWorkspaceRoot": cwd, **(selection or {})})
    return {"projectId": project_id, "workspaceRoot": cwd, **result}


def t3(args, quiet=False):
    """Call the T3 instance on the execution host; never relocate native logins."""
    import urllib.error
    import urllib.parse
    import urllib.request
    if len(args) == 2 and args[0] == "auto-import" and args[1] in ("on", "off", "status"):
        if args[1] != "status":
            settings = config()
            settings["t3_auto_import"] = args[1] == "on"
            private_json_write(CONFIG, settings)
        return subprocess.call([sys.executable, require("code"), "thread-sync", "--status"])
    if len(args) == 3 and args[0] == "handoff":
        return subprocess.call([require("code"), "thread-export", args[1], args[2], "--completed", "--deliver-native-t3"])
    if args in (["connect"], ["renew"]):
        print(json.dumps(renew_t3_connection(if_needed=args == ["renew"]), indent=2))
        return 0
    if args and args[0] == "import":
        export_args = args[1:]
        if "--stopped" not in export_args and "--completed" not in export_args:
            export_args = [*export_args, "--completed"]
        return subprocess.call([require("code"), "thread-export", *export_args, "--deliver-t3"])
    starting = args[:1] == ["start"]
    waiting = args[:1] == ["wait"]
    importing_cwd = len(args) == 2 and args[0] == "import-cwd"
    inspecting = len(args) == 2 and args[0] in ("status", "stop")
    provider_sync = args in (["providers"], ["providers", "--apply"])
    native = starting or waiting or importing_cwd or inspecting or provider_sync or args in (["scan"], ["_receive-native"]) or (len(args) == 2 and args[0] == "import-project")
    if args != ["_receive"] and not native:
        raise SystemExit("usage: codespace t3 scan | providers [--apply] | import-project ID | import ACCOUNT SESSION [--stopped] [--model MODEL]")
    settings = config()
    base = settings.get("t3_url", "http://127.0.0.1:3773")
    if not isinstance(base, str):
        raise SystemExit("codespace: t3_url must be a URL")
    url = urllib.parse.urlsplit(base)
    if (url.scheme not in ("http", "https") or not url.hostname or url.username or url.password
            or url.query or url.fragment or url.path not in ("", "/")
            or (url.scheme == "http" and url.hostname not in ("127.0.0.1", "localhost", "::1"))):
        raise SystemExit("codespace: T3 requires HTTPS or a loopback HTTP URL without credentials")
    token = os.environ.get("CODESPACE_T3_TOKEN")
    if not token:
        token_path = Path(settings.get("t3_token_file", str(CONFIG.parent / "t3-token"))).expanduser()
        try:
            token, _ = read_t3_token(token_path)
        except OSError:
            raise SystemExit("codespace: configure CODESPACE_T3_TOKEN or a private t3_token_file from `t3 auth session issue --token-only`") from None
    if not token or any(c.isspace() for c in token):
        raise SystemExit("codespace: invalid T3 session token")
    if args == ["_receive-native"]:
        raw = sys.stdin.buffer.read(16385)
        if len(raw) > 16384:
            raise ValueError("native handoff metadata is too large")
        payload = json.loads(raw)
        account_file = Path(os.environ.get("CODE_ACCOUNTS_DIR", str(Path.home() / ".code-accounts"))) / "accounts.json"
        accounts = json.loads(account_file.read_text())["accounts"]
        account = next((a for a in accounts if a["id"] == payload["account"]), None)
        if not account:
            raise ValueError("unknown handoff account")
        settings = t3_rpc_value(base, token, "server.getSettings", {})
        plan = t3_provider_plan([account], settings)
        if plan["additions"] or not plan["mappings"]:
            raise ValueError("configure the account with t3 providers --apply first")
        mapping = plan["mappings"][0]
        if os.path.realpath(mapping["home"]) != payload["sourceHome"]:
            raise ValueError("handoff account home changed")
        result = t3_import_cwd(payload["cwd"], base, token, {
            "providerInstanceId": mapping["instance"], "providerSessionId": payload["sessionId"]})
        print(json.dumps(result, indent=2))
        return 0
    if starting:
        return t3_start(args[1:], base, token)
    if waiting:
        return t3_wait(args[1:], base, token)
    if importing_cwd:
        result = t3_import_cwd(args[1], base, token)
        if quiet:
            return result
        print(json.dumps(result, indent=2))
        return 0
    if inspecting:
        import urllib.parse
        if args[0] == "status":
            result = t3_http(base, token, "/api/orchestration/threads/" + urllib.parse.quote(args[1], safe=""))
        else:
            import uuid, datetime
            result = t3_http(base, token, "/api/orchestration/dispatch", {"type": "thread.session.stop", "commandId": str(uuid.uuid4()), "threadId": args[1], "createdAt": datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z")})
        print(json.dumps(result, indent=2))
        return 0
    if native:
        try:
            timeout = int(settings.get("t3_timeout_seconds", 180))
        except (ValueError, TypeError):
            raise SystemExit("codespace: t3_timeout_seconds must be an integer from 5 to 1800") from None
        if not 5 <= timeout <= 1800:
            raise SystemExit("codespace: t3_timeout_seconds must be an integer from 5 to 1800")
        if provider_sync:
            def rpc(method, payload):
                result = subprocess.run([require("node"), "--input-type=module", "-e", T3_RPC_SCRIPT],
                    input=json.dumps({"base": base.rstrip("/"), "token": token, "method": method,
                                      "payload": payload, "timeoutSeconds": timeout}).encode(),
                    capture_output=True, timeout=timeout + 5)
                if result.returncode:
                    raise SystemExit("codespace: T3 provider settings request failed: " + result.stderr.decode(errors="replace").strip())
                return json.loads(result.stdout)
            account_file = Path(os.environ.get("CODE_ACCOUNTS_DIR", str(Path.home() / ".code-accounts"))) / "accounts.json"
            try:
                accounts = json.loads(account_file.read_text())["accounts"]
                current = rpc("server.getSettings", {})
                plan = t3_provider_plan(accounts, current)
                if args[-1] == "--apply" and plan["additions"]:
                    latest = rpc("server.getSettings", {})
                    if latest != current:
                        raise SystemExit("codespace: T3 settings changed during planning; retry")
                    updated = rpc("server.updateSettings", {"patch": {"providerInstances": {
                        **current.get("providerInstances", {}), **plan["additions"]}}})
                    for key, value in plan["additions"].items():
                        if updated.get("providerInstances", {}).get(key, {}).get("config", {}).get("homePath") != value["config"]["homePath"]:
                            raise SystemExit("codespace: T3 did not confirm the expected provider home")
                result = {"applied": args[-1] == "--apply", **plan}
                if quiet:
                    return result
                print(json.dumps(result, indent=2))
                return 0
            except (OSError, ValueError, KeyError, subprocess.TimeoutExpired) as error:
                raise SystemExit("codespace: provider synchronization failed: " + str(error)) from None
        method = "agentSessions.scan" if args == ["scan"] else "agentSessions.import"
        if method == "agentSessions.import" and shared_t3_history(t3_rpc_value(base, token, "server.getSettings", {})):
            raise SystemExit("codespace: provider instances share transcript directories; workspace import would duplicate history")
        payload = {} if args == ["scan"] else {"projectId": args[1]}
        try:
            return subprocess.run([require("node"), "--input-type=module", "-e", T3_RPC_SCRIPT],
                                  input=json.dumps({"base": base.rstrip("/"), "token": token,
                                                    "method": method, "payload": payload, "timeoutSeconds": timeout}).encode(),
                                  timeout=timeout + 5).returncode
        except subprocess.TimeoutExpired:
            raise SystemExit("codespace: native T3 RPC timed out") from None
    payload = sys.stdin.buffer.read(32 * 1024 * 1024 + 1)
    if len(payload) > 32 * 1024 * 1024:
        raise SystemExit("codespace: T3 history exceeds the 32 MiB transport limit")
    # A redirect must never carry the bearer credential to another origin.
    class NoRedirect(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, req, fp, code, msg, headers, newurl):
            return None
    request = urllib.request.Request(base.rstrip("/") + "/api/codespace/import", data=payload,
                                     headers={"Authorization": "Bearer " + token, "Content-Type": "application/json"}, method="POST")
    try:
        with urllib.request.build_opener(NoRedirect).open(request, timeout=60) as response:
            imported = json.load(response)
    except urllib.error.HTTPError as error:
        if error.code == 404:
            raise SystemExit("codespace: this T3 host does not have the Codespace import bridge installed") from None
        if error.code in (401, 403):
            raise SystemExit("codespace: T3 session is expired, revoked, or lacks orchestration permission; issue a new session token") from None
        try:
            detail = json.loads(error.read(8192)).get("error", "Import failed")
        except (ValueError, AttributeError):
            detail = "Import failed"
        raise SystemExit(f"codespace: T3 HTTP {error.code}: {detail}") from None
    except (urllib.error.URLError, TimeoutError, ValueError) as error:
        raise SystemExit(f"codespace: T3 import could not finish ({type(error).__name__}); retrying the same session is safe") from None
    print(json.dumps(imported, indent=2))
    return 0


def execution_plan(workload, portable, needs, target, memory_mb):
    local_needs = set(needs) & {"browser", "desktop", "keychain", "macos", "local-network"}
    if target == "space" and (not portable or local_needs):
        raise ValueError("Space requires a portable task with no Mac-only dependencies")
    if target == "auto":
        cloud = portable and not local_needs and (workload in {"compute", "build", "test", "media", "download"} or memory_mb >= 4096)
        target = "space" if cloud else "local"
    reason = ("Mac-only dependency: " + ", ".join(sorted(local_needs)) if local_needs else
              "portable resource-intensive work" if target == "space" else "local execution requested or portability not established")
    return {"target": target, "reason": reason, "workload": workload,
            "needs": sorted(needs), "portable": portable, "memory_mb": memory_mb}


def run_workload(args):
    import argparse
    import shlex
    parser = argparse.ArgumentParser(prog="codespace run")
    parser.add_argument("--target", choices=["auto", "local", "space"], default="auto")
    parser.add_argument("--workload", choices=["general", "compute", "build", "test", "media", "download"], default="general")
    parser.add_argument("--portable", action="store_true", help="declare that the command and its inputs can run on a Linux worker without this Mac's logins")
    parser.add_argument("--needs", action="append", choices=["browser", "desktop", "keychain", "macos", "local-network"], default=[])
    parser.add_argument("--memory-mb", type=int, default=0)
    parser.add_argument("--file", "-f", action="append", default=[])
    parser.add_argument("--timeout", type=int, default=1800)
    parser.add_argument("--wait", action="store_true", help="wait for a cloud result; otherwise return its job ID")
    parser.add_argument("--plan", action="store_true", help="show the routing decision without running or uploading anything")
    parser.add_argument("command", nargs=argparse.REMAINDER)
    opts = parser.parse_args(args)
    command = opts.command[1:] if opts.command[:1] == ["--"] else opts.command
    if not command:
        parser.error("provide a command after --")
    if opts.memory_mb < 0 or not 1 <= opts.timeout <= 86400:
        parser.error("memory must be nonnegative and timeout must be between 1 and 86400 seconds")
    try:
        plan = execution_plan(opts.workload, opts.portable, opts.needs, opts.target, opts.memory_mb)
    except ValueError as error:
        parser.error(str(error))
    files = [Path(name).expanduser().resolve() for name in opts.file]
    if len({p.name for p in files}) != len(files):
        parser.error("input files must have unique basenames")
    for path in files:
        if not path.is_file() or path.stat().st_size > 100 * 1024 * 1024:
            parser.error("--file accepts regular files up to 100 MiB; use Space for larger inputs")
    plan.update(command=command, inputs=[str(p) for p in files], timeout_seconds=opts.timeout)
    if opts.plan:
        print(json.dumps(plan, indent=2))
        return 0
    print("Codespace: " + plan["target"] + " — " + plan["reason"], file=sys.stderr)
    if plan["target"] == "space":
        invocation = [require("space"), "job", "run", "--timeout", str(opts.timeout)]
        if not opts.wait:
            invocation.append("--async")
        else:
            invocation += ["--wait", str(opts.timeout + 120)]
        for path in files:
            invocation += ["--file", str(path)]
        invocation += ["--", shlex.join(command)]
        environment = dict(os.environ)
        if not environment.get("CLOUDSDK_PYTHON") and Path("/opt/homebrew/bin/python3").exists():
            environment["CLOUDSDK_PYTHON"] = "/opt/homebrew/bin/python3"
        return subprocess.call(invocation, env=environment)
    cwd = None
    if files:
        import uuid
        workspace = RELEASE_ROOT / "jobs" / str(uuid.uuid4())
        (workspace / "input").mkdir(parents=True, mode=0o700)
        (workspace / "out").mkdir()
        for path in files:
            shutil.copy2(path, workspace / "input" / path.name)
        cwd = str(workspace)
        print("Codespace local job files: " + cwd, file=sys.stderr)
    import signal
    child = subprocess.Popen(command, cwd=cwd, start_new_session=True)
    def stop():
        try:
            os.killpg(child.pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        try:
            child.wait(timeout=5)
        except subprocess.TimeoutExpired:
            os.killpg(child.pid, signal.SIGKILL)
            child.wait()
    try:
        return child.wait(timeout=opts.timeout)
    except subprocess.TimeoutExpired:
        stop()
        print("Codespace: local command exceeded its timeout", file=sys.stderr)
        return 124
    except KeyboardInterrupt:
        stop()
        raise



BRIDGE_PEER_SCRIPT = r"""
